# Ambiente Wayland per labwc-q4os
# labwc legge questo file all'avvio. Formato: CHIAVE=valore (niente export).
XDG_SESSION_TYPE=wayland
XDG_CURRENT_DESKTOP=labwc
XDG_SESSION_DESKTOP=labwc
GDK_BACKEND=wayland,x11
GTK_THEME=Adwaita:dark
GTK_CSD=0
MOZ_GTK_TITLEBAR_DECORATION=system
QT_QPA_PLATFORM=wayland;xcb
QT_WAYLAND_DISABLE_WINDOWDECORATION=1
QT_AUTO_SCREEN_SCALE_FACTOR=1
MOZ_ENABLE_WAYLAND=1
SDL_VIDEODRIVER=wayland
CLUTTER_BACKEND=wayland
ELECTRON_OZONE_PLATFORM_HINT=auto
XCURSOR_THEME=Adwaita
XCURSOR_SIZE=24

# Layout tastiera (sovrascritto dall'installer in base alla lingua)
XKB_DEFAULT_LAYOUT=it
