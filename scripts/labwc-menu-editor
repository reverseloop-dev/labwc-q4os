#!/usr/bin/env bash
# =============================================================================
#  labwc-menu-editor - gestione interattiva delle app nel menu tasto destro
#  Uso: labwc-menu-editor [add]
#  UI: Fuzzel (Wayland) -> Zenity -> Whiptail
# =============================================================================
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

SHARE="${LABWC_Q4OS_SHARE:-${XDG_DATA_HOME:-$HOME/.local/share}/labwc-q4os}"
RENDER="$SHARE/scripts/render-menu.py"

if [ ! -r "$RENDER" ]; then
    printf 'render-menu.py non trovato: %s\n' "$RENDER" >&2
    exit 1
fi

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    [ -n "${WAYLAND_DISPLAY:-}" ] || return 0
    notify-send -a "Labwc menu" "$1" "${2:-}" >/dev/null 2>&1 || true
}

reconfigure() {
    if pgrep -x labwc >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        labwc --reconfigure >/dev/null 2>&1 || pkill -HUP -x labwc >/dev/null 2>&1 || true
    fi
}

# Sceglie una voce. Gli argomenti sono le voci visualizzate.
choose() {
    local prompt="$1"; shift
    [ "$#" -gt 0 ] || return 1

    if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v fuzzel >/dev/null 2>&1; then
        printf '%s\n' "$@" |
            fuzzel --dmenu --prompt="$prompt" --width=64 --lines=16
        return
    fi

    if [ -n "${DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; then
        zenity --list --title="Labwc — Menu" --text="$prompt" \
            --column="Scelta" --width=760 --height=560 "$@"
        return
    fi

    if command -v whiptail >/dev/null 2>&1; then
        local args=() opt
        for opt in "$@"; do
            args+=("$opt" "")
        done
        whiptail --title="Labwc — Menu" --menu "$prompt" 24 100 14 "${args[@]}" \
            3>&1 1>&2 2>&3
        return
    fi

    printf 'Nessuna interfaccia disponibile (serve fuzzel, zenity o whiptail).\n' >&2
    return 1
}

add_flow() {
    while true; do
        mapfile -t rows < <("$RENDER" --list-available)
        if [ "${#rows[@]}" -eq 0 ]; then
            notify "Nessuna applicazione disponibile" "Tutte le app trovate sono gia' nel menu."
            return 0
        fi

        local displays=() i idx display name comment id
        for i in "${!rows[@]}"; do
            IFS=$'\t' read -r id name comment <<<"${rows[$i]}"
            printf -v idx '%03d' "$((i + 1))"
            display="$idx  $name"
            [ -n "$comment" ] && display+=" — $comment"
            displays+=("$display")
        done

        local choice
        choice="$(choose "Aggiungi app > " "${displays[@]}")" || return 0
        [ -n "$choice" ] || return 0

        if ! [[ "$choice" =~ ^([0-9]{3})[[:space:]]+(.*)$ ]]; then
            notify "Selezione non valida" "Riprova dal menu."
            return 0
        fi
        idx="${BASH_REMATCH[1]}"
        i=$((10#$idx - 1))
        if [ "$i" -lt 0 ] || [ "$i" -ge "${#rows[@]}" ]; then
            notify "Selezione non valida" "Riprova dal menu."
            return 0
        fi

        IFS=$'\t' read -r id name comment <<<"${rows[$i]}"
        if "$RENDER" --add "$id"; then
            reconfigure
            notify "Aggiunta al menu: $name" "Il menu del tasto destro e' gia' aggiornato."
        else
            notify "Errore" "Impossibile aggiungere $name."
            return 1
        fi
    done
}

remove_flow() {
    while true; do
        mapfile -t rows < <("$RENDER" --list-favorites)
        if [ "${#rows[@]}" -eq 0 ]; then
            notify "Nessuna app preferita" "Aggiungi prima un'app dal menu."
            return 0
        fi

        local displays=() i idx label id
        for i in "${!rows[@]}"; do
            IFS=$'\t' read -r idx label id <<<"${rows[$i]}"
            printf -v idx '%03d' "$idx"
            displays+=("$idx  $label")
        done

        local choice
        choice="$(choose "Rimuovi app > " "${displays[@]}")" || return 0
        [ -n "$choice" ] || return 0

        if ! [[ "$choice" =~ ^([0-9]{3})[[:space:]]+(.*)$ ]]; then
            notify "Selezione non valida" "Riprova dal menu."
            return 0
        fi
        idx="${BASH_REMATCH[1]}"
        label="${BASH_REMATCH[2]}"

        if "$RENDER" --remove "$((10#$idx))"; then
            reconfigure
            notify "Rimossa dal menu: $label" "Il menu del tasto destro e' gia' aggiornato."
        else
            notify "Errore" "Impossibile rimuovere la voce."
            return 1
        fi
    done
}

show_favorites() {
    mapfile -t rows < <("$RENDER" --list-favorites)
    if [ "${#rows[@]}" -eq 0 ]; then
        notify "Nessuna app preferita" "Usa 'Aggiungi un'app al menu'."
        return 0
    fi
    local displays=() i idx label id
    for i in "${!rows[@]}"; do
        IFS=$'\t' read -r idx label id <<<"${rows[$i]}"
        displays+=("$label")
    done
    choose "App preferite (Esc per chiudere) > " "${displays[@]}" >/dev/null || true
}

main_menu() {
    while true; do
        local choice
        choice="$(choose "Menu labwc > " \
            "Aggiungi un'app al menu" \
            "Rimuovi un'app dal menu" \
            "Mostra le app preferite" \
            "Ricarica menu e desktop" \
            "Apri aiuto e scorciatoie" \
            "Chiudi")" || exit 0
        [ -n "$choice" ] || exit 0

        case "$choice" in
            "Aggiungi"*) add_flow ;;
            "Rimuovi"*) remove_flow ;;
            "Mostra"*) show_favorites ;;
            "Ricarica"*) labwc-reload ;;
            "Apri"*) labwc-help ;;
            *) exit 0 ;;
        esac
    done
}

case "${1:-}" in
    add)
        add_flow
        exit $?
        ;;
    remove-id)
        [ "$#" -ge 2 ] || { printf 'Uso: labwc-menu-editor remove-id ID\n' >&2; exit 2; }
        if "$RENDER" --remove-id "$2"; then
            reconfigure
            notify "Rimossa dal menu" "$2"
        else
            notify "Errore" "Impossibile rimuovere $2."
            exit 1
        fi
        exit 0
        ;;
    remove)
        remove_flow
        exit $?
        ;;
esac

main_menu
