#!/usr/bin/env bash
# =============================================================================
#  labwc-cage-app - avvia l'app dentro Cage con il HUD batteria (Ctrl+Alt+B).
#
#  Cage mostra un solo client e non ha layer-shell: il HUD viene iniettato
#  nella pagina tramite il DevTools di Chromium/Electron su 127.0.0.1.
#  Per le app Chromium la porta di debug viene aggiunta qui; per FreeTube il
#  file DevToolsActivePort e' gia' creato da labwc-freetube-cage.
#
#  Uso: labwc-cage-app COMANDO [ARGOMENTI...]
# =============================================================================
set -u

child_command=("$@")
if [ "${#child_command[@]}" -eq 0 ]; then
    echo "labwc-cage-app: nessun comando" >&2
    exit 1
fi

app="$(basename -- "${child_command[0]}")"
hud="${LABWC_CAGE_HUD:-$HOME/.local/bin/labwc-cage-hud}"
hud_pid=""

stop_hud() {
    if [ -n "$hud_pid" ]; then
        kill -TERM "$hud_pid" 2>/dev/null || true
        wait "$hud_pid" 2>/dev/null || true
        hud_pid=""
    fi
}
trap stop_hud EXIT TERM INT HUP

start_hud() {
    [ -f "$hud" ] || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    if [ "${LABWC_CAGE_HUD_DEBUG:-}" = "1" ]; then
        # Diagnostica: log in ~/.local/state/labwc-q4os/cage-hud.log
        local logdir="${XDG_STATE_HOME:-$HOME/.local/state}/labwc-q4os"
        mkdir -p "$logdir"
        python3 "$hud" "$@" >>"$logdir/cage-hud.log" 2>&1 &
    else
        python3 "$hud" "$@" >/dev/null 2>&1 &
    fi
    hud_pid=$!
}

is_chromium=0
case "$app" in
    chromium|chromium-browser|google-chrome|google-chrome-stable|brave-browser|brave|\
    microsoft-edge|microsoft-edge-stable|vivaldi|vivaldi-stable|opera|thorium)
        is_chromium=1
        ;;
esac

has_debug_port=0
debug_port=""
for arg in "${child_command[@]:1}"; do
    case "$arg" in
        --remote-debugging-port=*)
            has_debug_port=1
            debug_port="${arg#--remote-debugging-port=}"
            ;;
    esac
done

# Addon batteria (Firefox/Chromium) installato dall'installer: se c'e', il HUD
# arriva dall'estensione e non serve ne' il DevTools ne' la sessione BiDi.
battery_addon=0
if [ "$app" = "firefox" ] || [ "$app" = "firefox-esr" ]; then
    for f in /usr/lib/firefox-esr/browser/extensions/labwc-q4os-battery@reverseloop.dev.xpi \
             /usr/lib/firefox/browser/extensions/labwc-q4os-battery@reverseloop.dev.xpi; do
        [ -s "$f" ] && battery_addon=1
    done
elif [ "$is_chromium" -eq 1 ]; then
    battery_ext="${LABWC_CAGE_BATTERY_EXT:-/usr/share/labwc-q4os/battery-hud/chromium}"
    [ -f "$battery_ext/manifest.json" ] && battery_addon=1
    if [ "$battery_addon" -eq 1 ]; then
        child_command+=("--load-extension=$battery_ext")
    fi
fi

# Firefox: apri direttamente la nuova scheda dell'addon come prima pagina, cosi'
# il HUD c'e' anche sulla pagina iniziale vuota (about:blank non puo' ospitare
# content script). L'UUID dell'estensione e' nel profilo.
if [ "$battery_addon" -eq 1 ] && { [ "$app" = "firefox" ] || [ "$app" = "firefox-esr" ]; }; then
    has_url=0
    for arg in "${child_command[@]:1}"; do
        case "$arg" in
            http://*|https://*|file://*|about:*|moz-extension://*) has_url=1 ;;
        esac
    done
    if [ "$has_url" -eq 0 ]; then
        ff_uuid="$(
            python3 - "$HOME/.mozilla/firefox" <<'PY' 2>/dev/null || true
import json, os, re, sys
base = sys.argv[1]
ini = os.path.join(base, "profiles.ini")
profile = ""
try:
    section = ""
    for line in open(ini, encoding="utf-8", errors="ignore"):
        line = line.strip()
        if line.startswith("["):
            section = line
        elif line.startswith("Default=") and section == "[Install4F96D1932A9F858E]":
            profile = line.split("=", 1)[1]
    if not profile:
        for line in open(ini, encoding="utf-8", errors="ignore"):
            if line.startswith("Default="):
                profile = line.split("=", 1)[1].strip()
                break
except OSError:
    profile = ""
prefs = os.path.join(base, profile, "prefs.js") if profile else ""
try:
    text = open(prefs, encoding="utf-8", errors="ignore").read()
except OSError:
    raise SystemExit(0)
match = re.search(r'user_pref\("extensions\.webextensions\.uuids",\s*(".*?")\);', text, re.S)
if not match:
    raise SystemExit(0)
try:
    mapping = json.loads(json.loads(match.group(1)))
except Exception:
    raise SystemExit(0)
print(mapping.get("labwc-q4os-battery@reverseloop.dev", ""))
PY
        )"
        if [ -n "${ff_uuid:-}" ]; then
            child_command+=("moz-extension://$ff_uuid/newtab.html")
        fi
    fi
fi

free_port() {
    python3 - <<'PY' 2>/dev/null
import socket
sock = socket.socket()
sock.bind(("127.0.0.1", 0))
print(sock.getsockname()[1])
sock.close()
PY
}

if [ "$battery_addon" -eq 1 ]; then
    : # HUD fornito dall'addon: niente porte di debug ne' sessione BiDi.
elif [ "$is_chromium" -eq 1 ]; then
    if [ "$has_debug_port" -eq 0 ]; then
        port="$(free_port)"
        if [ -n "${port:-}" ]; then
            child_command+=(
                "--remote-debugging-port=$port"
                "--remote-debugging-address=127.0.0.1"
                "--remote-allow-origins=http://127.0.0.1:$port"
            )
            start_hud --port "$port"
        fi
    elif [ -n "$debug_port" ]; then
        # Porta gia' passata dal chiamante: usa quella per il HUD.
        start_hud --port "$debug_port"
    fi
elif [ "$app" = "freetube" ]; then
    port_file="${XDG_CONFIG_HOME:-$HOME/.config}/FreeTube/DevToolsActivePort"
    start_hud --port-file "$port_file"
elif [ "$app" = "firefox" ] || [ "$app" = "firefox-esr" ]; then
    # Firefox espone WebDriver BiDi su localhost: stesso HUD via --bidi.
    if [ "$has_debug_port" -eq 0 ]; then
        port="$(free_port)"
        if [ -n "${port:-}" ]; then
            child_command+=("--remote-debugging-port=$port")
            start_hud --bidi "$port"
        fi
    elif [ -n "$debug_port" ]; then
        start_hud --bidi "$debug_port"
    fi
else
    printf 'HUD batteria: app non supportata dal HUD (%s).\n' "$app" >&2
fi

exec "${child_command[@]}"
