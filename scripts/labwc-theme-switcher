#!/usr/bin/env bash
# =============================================================================
#  labwc-theme-switcher - selettore tema a caldo (Fuzzel / Zenity)
#  Uso: labwc-theme-switcher [nordic-cobalt|muted-crimson|sage-emerald]
# =============================================================================
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

SHARE="${LABWC_Q4OS_SHARE:-${XDG_DATA_HOME:-$HOME/.local/share}/labwc-q4os}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
APPLY="$HOME/.local/bin/labwc-theme-apply"

if [ ! -x "$APPLY" ]; then
    APPLY="$SHARE/scripts/labwc-theme-apply"
fi

# Con un argomento applica direttamente (usato dal menu tasto destro)
if [ "${1:-}" != "" ] && [ "${1#-}" = "$1" ]; then
    exec "$APPLY" "$1"
fi

current="nordic-cobalt"
if [ -r "$CONFIG/labwc/theme" ]; then
    current="$(tr -d '[:space:]' < "$CONFIG/labwc/theme")"
fi

labels=(
    "Nordic Cobalt — blu profondo, elegante"
    "Muted Crimson — rosso tenue, caldo"
    "Sage Emerald — verde salvia, moderno"
)
ids=(nordic-cobalt muted-crimson sage-emerald)

entries=()
for i in "${!ids[@]}"; do
    marker="  "
    [ "${ids[$i]}" = "$current" ] && marker="● "
    entries+=("$marker${labels[$i]}")
done

choose_theme() {
    if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v fuzzel >/dev/null 2>&1; then
        printf '%s\n' "${entries[@]}" |
            fuzzel --dmenu --prompt="Tema > " --width=56 --lines=5
        return
    fi
    if [ -n "${DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; then
        zenity --list --title="Labwc — Cambia tema" --text="Scegli la palette del desktop" \
            --column="Tema" --width=560 --height=300 "${entries[@]}"
        return
    fi
    printf 'Nessun selettore grafico disponibile. Usa: labwc-theme-switcher <tema>\n' >&2
    printf 'Temi: %s\n' "${ids[*]}" >&2
    return 1
}

choice="$(choose_theme)" || exit 0
[ -n "$choice" ] || exit 0

selected=""
case "$choice" in
    *"Nordic Cobalt"*) selected="nordic-cobalt" ;;
    *"Muted Crimson"*) selected="muted-crimson" ;;
    *"Sage Emerald"*) selected="sage-emerald" ;;
esac

if [ -z "$selected" ]; then
    printf 'Scelta non riconosciuta: %s\n' "$choice" >&2
    exit 1
fi

exec "$APPLY" "$selected"
