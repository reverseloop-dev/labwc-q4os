#!/usr/bin/env bash
# =============================================================================
#  labwc-cage-help - console di avvio Cage con istruzioni
# =============================================================================
set -u
cat <<'EOF'

  AVVIA CAGE
  ==========
  Con labwc-cage (o i collegamenti "(cage)") l'app si apre a schermo
  intero e, quando la chiudi, torni AUTOMATICAMENTE a labwc.

  Esempi:
    labwc-cage -- chromium
    labwc-cage -- librewolf
    labwc-cage -- freetube
    labwc-cage -- firefox

  Se invece lanci `cage` manualmente dalla console, alla chiusura resti
  nella shell. Per tornare a labwc:
    labwc-return
  oppure:
    Ctrl+Alt+F1

  Tasti volume: vengono gestiti da keyd anche dentro Cage.

EOF
exec "${SHELL:-/bin/bash}" -i
