#!/usr/bin/env bash
# =============================================================================
#  labwc-cage-help - console di avvio Cage con istruzioni
#
#  Quando la console viene chiusa (exit, Ctrl+D, chiusura del terminale)
#  scrive un marcatore letto dal supervisore di sessione: Cage e le app
#  rimaste vengono terminati, come con la X di FreeTube.
# =============================================================================
set -u

close_req="${LABWC_CAGE_CLOSE:-}"

write_close_request() {
    [ -n "$close_req" ] || return 0
    mkdir -p "$(dirname "$close_req")" 2>/dev/null || true
    printf '%s\n' "$$" >"$close_req" 2>/dev/null || true
}

trap write_close_request EXIT
trap 'exit 129' HUP
trap 'exit 143' TERM

cat <<'EOF'

  AVVIA CAGE
  ==========
  Sei dentro Cage con labwc chiuso. Avvia un'app direttamente:
    chromium
    firefox-esr
    labwc-freetube-cage     (FreeTube con pulsante X o Ctrl+Shift+Q)
    firefox

  Chiudi l'app per tornare a questa shell.
  Per uscire da Cage e riaprire labwc automaticamente:
    exit

  Uscire dalla console chiude Cage e tutte le app rimaste, come la X di
  FreeTube. Salva i documenti aperti prima di uscire.

  Tasti volume: vengono gestiti da keyd anche dentro Cage.
  Batteria: Ctrl+. (Ctrl e punto) mostra/nasconde la percentuale in basso a
  sinistra (Chromium, FreeTube e Firefox).

EOF
"${SHELL:-/bin/bash}" -i
