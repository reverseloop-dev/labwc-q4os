#!/usr/bin/env bash
# =============================================================================
#  labwc-cage-help - console di avvio Cage con istruzioni
# =============================================================================
set -u
cat <<'EOF'

  AVVIA CAGE
  ==========
  Sei dentro Cage con labwc chiuso. Avvia un'app direttamente:
    chromium
    librewolf
    labwc-freetube-cage     (FreeTube con pulsante X)
    firefox

  Chiudi l'app per tornare a questa shell.
  Per uscire da Cage e riaprire labwc automaticamente:
    exit

  Salva i documenti aperti prima di chiudere le app.

  Tasti volume: vengono gestiti da keyd anche dentro Cage.

EOF
exec "${SHELL:-/bin/bash}" -i
