#!/usr/bin/env bash
# =============================================================================
#  labwc-update-popup - avviso di nuova versione (15 secondi, tre azioni)
#  La finestra GTK3 vive in labwc-update-gui --popup, cosi' popup e pannello
#  condividono tema e comportamento. Fallback: notifica Mako persistente.
# =============================================================================
set -uo pipefail

installed="${1:-?}"
online="${2:-?}"
GUI="$HOME/.local/bin/labwc-update-gui"

if [ -x "$GUI" ] &&
   python3 -c 'import gi' >/dev/null 2>&1 &&
   { [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; }; then
    exec "$GUI" --popup "$installed" "$online"
fi

if command -v notify-send >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    notify-send -a "labwc-q4os-update" -u normal -i software-update-available \
        "Nuova versione di labwc-q4os: $online" \
        "Installata $installed · aggiorna dal pannello Aggiornamenti" \
        >/dev/null 2>&1 || true
    exit 0
fi

printf 'Nuova versione di labwc-q4os: installata %s, disponibile %s\n' \
    "$installed" "$online" >&2
exit 0
