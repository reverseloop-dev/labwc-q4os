#!/usr/bin/env bash
# =============================================================================
#  labwc-session-start - avvio componenti della sessione labwc
#  Richiamato da ~/.config/labwc/autostart
# =============================================================================
set -uo pipefail

SHARE="${LABWC_Q4OS_SHARE:-${XDG_DATA_HOME:-$HOME/.local/share}/labwc-q4os}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/labwc-q4os"
LOG="$STATE/session.log"

mkdir -p "$STATE" "$HOME/.local/bin"
exec >>"$LOG" 2>&1
printf '\n===== labwc-q4os: avvio sessione %s =====\n' "$(date '+%Y-%m-%d %H:%M:%S')"

export PATH="$HOME/.local/bin:$PATH"

# Rende disponibili le variabili Wayland a DBus/portali
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
        XDG_RUNTIME_DIR 2>/dev/null || true
fi

start_once() {
    local name="$1"; shift
    if pgrep -x "$name" >/dev/null 2>&1; then
        printf 'gia attivo: %s\n' "$name"
        return 0
    fi
    if command -v "$1" >/dev/null 2>&1; then
        setsid -f "$@" || printf 'avvio fallito: %s\n' "$name"
        printf 'avviato: %s\n' "$name"
    else
        printf 'non installato: %s\n' "$1"
    fi
}

# Shell scelta dall'installer (marker ~/.config/labwc/shell): waybar di default.
# Se il marker manca (installazione interrotta o config ripristinata), lo
# ricaviamo da /etc/labwc-q4os/install-options e lo riscriviamo: altrimenti
# una macchina con Noctalia resterebbe senza barra/launcher.
shell_mode=""
if [ -r "$CONFIG/labwc/shell" ]; then
    shell_mode="$(tr -d '[:space:]' < "$CONFIG/labwc/shell")"
fi
case "$shell_mode" in
    waybar|noctalia) ;;
    *) shell_mode="" ;;
esac
if [ -z "$shell_mode" ] && [ -r /etc/labwc-q4os/install-options ]; then
    shell_mode="$(sed -n 's/^SHELL=//p' /etc/labwc-q4os/install-options |
        head -n1 | tr -d '[:space:]')"
fi
case "$shell_mode" in
    waybar|noctalia) ;;
    *)
        if command -v noctalia >/dev/null 2>&1 &&
            ! command -v waybar >/dev/null 2>&1; then
            shell_mode=noctalia
        else
            shell_mode=waybar
        fi
        ;;
esac
mkdir -p "$CONFIG/labwc"
printf '%s\n' "$shell_mode" >"$CONFIG/labwc/shell"
chmod 0644 "$CONFIG/labwc/shell" 2>/dev/null || true
use_noctalia=0
if [ "$shell_mode" = "noctalia" ]; then
    if command -v noctalia >/dev/null 2>&1; then
        use_noctalia=1
    else
        printf 'shell: marker noctalia ma comando mancante, uso Waybar+Mako+swaybg\n'
        if command -v notify-send >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
            notify-send -a "Labwc" "Noctalia non installato" \
                "Uso Waybar + Fuzzel. Reinstalla con --shell noctalia." >/dev/null 2>&1 || true
        fi
    fi
fi

if [ "$use_noctalia" -eq 1 ]; then
    # Noctalia fornisce barra, launcher e notifiche: niente waybar/mako.
    pkill -x waybar >/dev/null 2>&1 || true
    pkill -x mako >/dev/null 2>&1 || true
    # Sfondo immediato: Noctalia impiega qualche secondo a inizializzarsi.
    # swaybg viene fermato quando Noctalia ha applicato lo sfondo.
    theme_boot="nordic-cobalt"
    [ -r "$CONFIG/labwc/theme" ] && theme_boot="$(tr -d '[:space:]' < "$CONFIG/labwc/theme")"
    boot_wall="$SHARE/wallpapers/$theme_boot.png"
    if [ -f "$boot_wall" ] && command -v swaybg >/dev/null 2>&1; then
        pkill -x swaybg >/dev/null 2>&1 || true
        setsid -f swaybg -m fill -i "$boot_wall" >>"$LOG" 2>&1 || true
        printf 'sfondo immediato: %s\n' "$boot_wall"
    fi
    # Noctalia parte subito: l'overlay 99-labwc-q4os.toml disattiva i download
    # all'avvio (offline_mode), quindi non dipende dal DNS del login.
    # Un'istanza orfana di un labwc precedente non deve far saltare l'avvio:
    # la fermiamo e ne avviamo una nuova sulla sessione corrente.
    if pgrep -x noctalia >/dev/null 2>&1; then
        pkill -x noctalia >/dev/null 2>&1 || true
        for _ in $(seq 1 20); do
            pgrep -x noctalia >/dev/null 2>&1 || break
            sleep 0.1
        done
    fi
    setsid -f noctalia >>"$LOG" 2>&1 || printf 'avvio fallito: noctalia\n'
else
    # Una sola shell attiva: se Noctalia era partita, la fermiamo.
    pkill -x noctalia >/dev/null 2>&1 || true
fi

# Sfondo coordinato al tema corrente
theme="nordic-cobalt"
[ -r "$CONFIG/labwc/theme" ] && theme="$(tr -d '[:space:]' < "$CONFIG/labwc/theme")"
wallpaper="$SHARE/wallpapers/$theme.png"
if [ ! -f "$wallpaper" ]; then
    wallpaper="$SHARE/wallpapers/nordic-cobalt.png"
fi
if [ "$use_noctalia" -eq 0 ] && [ -f "$wallpaper" ] && command -v swaybg >/dev/null 2>&1; then
    if pkill -x swaybg >/dev/null 2>&1; then sleep 0.15; fi
    setsid -f swaybg -m fill -i "$wallpaper"
    printf 'sfondo: %s\n' "$wallpaper"
fi

# Noctalia disegna il proprio sfondo: allinea il tema e la palette wallpaper.
# In background: il login non deve attendere che la shell sia pronta.
if [ "$use_noctalia" -eq 1 ]; then
    (
        attempt=0
        while [ "$attempt" -lt 60 ]; do
            if timeout 2 noctalia msg config-set wallpaper.directory \
                "\"$SHARE/wallpapers\""; then
                timeout 2 noctalia msg config-set theme.source '"wallpaper"' \
                    >/dev/null 2>&1 || true
                break
            fi
            attempt=$((attempt + 1))
            sleep 0.5
        done
        [ "$attempt" -lt 60 ] || printf 'shell: cartella sfondi Noctalia non impostata\n'
        if [ -f "$wallpaper" ]; then
            attempt=0
            while [ "$attempt" -lt 60 ]; do
                if timeout 2 noctalia msg wallpaper-set "$wallpaper"; then
                    printf 'shell: sfondo Noctalia impostato\n'
                    pkill -x swaybg >/dev/null 2>&1 || true
                    break
                fi
                attempt=$((attempt + 1))
                sleep 0.5
            done
            [ "$attempt" -lt 60 ] || printf 'shell: wallpaper-set Noctalia non riuscito\n'
        fi
    ) >>"$LOG" 2>&1 &
fi

# Barra e notifiche
if [ "$use_noctalia" -eq 0 ] && command -v waybar >/dev/null 2>&1; then
    if pkill -x waybar >/dev/null 2>&1; then sleep 0.25; fi
    setsid -f waybar -c "$CONFIG/waybar/config.jsonc" -s "$CONFIG/waybar/style.css"
    printf 'avviato: waybar\n'
fi

if [ "$use_noctalia" -eq 0 ] && command -v mako >/dev/null 2>&1; then
    start_once mako mako -c "$CONFIG/mako/config"
fi

# Agenti di sistema
command -v nm-applet >/dev/null 2>&1 && start_once nm-applet nm-applet --indicator
command -v lxpolkit >/dev/null 2>&1 && start_once lxpolkit lxpolkit

# Portachiavi (se presente)
if command -v gnome-keyring-daemon >/dev/null 2>&1; then
    if ! pgrep -x gnome-keyring-d >/dev/null 2>&1; then
        eval "$(gnome-keyring-daemon --start --components=secrets 2>/dev/null)" || true
    fi
fi

# Cronologia appunti (testo + immagini)
if command -v cliphist >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1; then
    if ! pgrep -f "wl-paste --type text --watch cliphist store" >/dev/null 2>&1; then
        setsid -f wl-paste --type text --watch cliphist store || true
    fi
    if ! pgrep -f "wl-paste --type image --watch cliphist store" >/dev/null 2>&1; then
        setsid -f wl-paste --type image --watch cliphist store || true
    fi
fi

# Touchscreen: tastiera su schermo e gesti (attivati dall'installer)
if [ ! -f "$CONFIG/labwc/touchscreen.enabled" ] &&
    [ -r /etc/labwc-q4os/install-options ] &&
    grep -qx 'TOUCH=1' /etc/labwc-q4os/install-options 2>/dev/null; then
    printf '1\n' >"$CONFIG/labwc/touchscreen.enabled"
    chmod 0644 "$CONFIG/labwc/touchscreen.enabled" 2>/dev/null || true
fi
if [ -f "$CONFIG/labwc/touchscreen.enabled" ]; then
    touch_event="$("$HOME/.local/bin/labwc-touchscreen" 2>/dev/null | head -n1 || true)"
    TOUCH_TAP="$HOME/.local/bin/labwc-touch-tap"
    if [ -n "$touch_event" ] && [ -x "$TOUCH_TAP" ] &&
        command -v python3 >/dev/null 2>&1; then
        pkill -f "$TOUCH_TAP" 2>/dev/null || true
        sleep 0.2
        setsid -f "$TOUCH_TAP" "$touch_event" >>"$LOG" 2>&1 &
        sleep 0.4
        if pgrep -f "$TOUCH_TAP" >/dev/null 2>&1; then
            printf 'touch: tap 2 dita=destro, 3 dita=Esc su %s\n' "$touch_event"
        else
            printf 'touch: labwc-touch-tap non partito (serve /dev/uinput 0660 gruppo input?)\n'
        fi
    fi
    if command -v wvkbd-mobintl >/dev/null 2>&1; then
        start_once wvkbd-mobintl wvkbd-mobintl --hidden -L 280
        sleep 0.2
        pgrep -x wvkbd-mobintl >/dev/null 2>&1 ||
            printf 'touch: wvkbd non partito (protocollo virtual-keyboard assente?)\n'
    else
        printf 'touch: wvkbd-mobintl non installato\n'
    fi
    if command -v lisgd >/dev/null 2>&1 && [ -n "$touch_event" ]; then
        if ! pgrep -x lisgd >/dev/null 2>&1; then
            # lisgd >=0.3 vuole 6 campi: dita,gesto,bordo,distanza,modo,comando.
            # DU = dal basso verso l'alto, partendo dal bordo inferiore (B),
            # actmode R (al rilascio); SIGRTMIN (34) e' un toggle.
            # -r 30 / -m 1200 allargano la tolleranza del gesto.
            setsid -f lisgd -d "$touch_event" -r 30 -m 1200 \
                -g "1,DU,B,*,R,pkill -34 -x wvkbd-mobintl"
            sleep 0.3
            if pgrep -x lisgd >/dev/null 2>&1; then
                printf 'touch: lisgd su %s (swipe dal bordo inferiore per la tastiera)\n' "$touch_event"
            else
                printf 'touch: lisgd non partito (utente nel gruppo input? serve un nuovo login)\n'
            fi
        fi
    elif [ -z "$touch_event" ]; then
        printf 'touch: nessun touchscreen rilevato\n'
    else
        printf 'touch: lisgd non installato\n'
    fi
fi

# Stato iniziale desktop 1-4
printf '1\n' > "$STATE/desktop"

# Controllo aggiornamenti dello script (se abilitato)
UPDATE_CHECK="$HOME/.local/bin/labwc-update-check"
if [ -x "$UPDATE_CHECK" ]; then
    if "$UPDATE_CHECK" --is-enabled >/dev/null 2>&1; then
        if pgrep -f 'labwc-update-check --startup' >/dev/null 2>&1; then
            printf 'gia attivo: labwc-update-check\n'
        else
            setsid -f "$UPDATE_CHECK" --startup >>"$LOG" 2>&1 || true
            printf 'avviato: labwc-update-check\n'
        fi
    fi
fi

# Cartelle XDG alla prima sessione
if command -v xdg-user-dirs-update >/dev/null 2>&1 && [ ! -f "$CONFIG/user-dirs.dirs" ]; then
    xdg-user-dirs-update || true
fi

printf '===== sessione pronta =====\n'
exit 0
