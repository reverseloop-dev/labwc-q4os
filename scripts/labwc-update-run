#!/usr/bin/env bash
# =============================================================================
#  labwc-update-run - apre Terminator con il comando di aggiornamento pronto
# =============================================================================
set -uo pipefail

COMMAND="curl -fsSL https://raw.githubusercontent.com/reverseloop-dev/labwc-q4os/main/bootstrap.sh | bash"
PROMPT='Labwc Q4OS: comando di aggiornamento pronto. Premi Invio per eseguirlo, Ctrl+C per annullare.'

if command -v terminator >/dev/null 2>&1; then
    exec terminator -x bash -c "CMD='$COMMAND'; printf '%s\\n' '$PROMPT'; read -e -i \"\$CMD\" -p '> ' ANSWER; printf '\\n'; eval \"\$ANSWER\""
fi

if command -v foot >/dev/null 2>&1; then
    exec foot -e bash -c "CMD='$COMMAND'; printf '%s\\n' '$PROMPT'; read -e -i \"\$CMD\" -p '> ' ANSWER; printf '\\n'; eval \"\$ANSWER\""
fi

# Fallback: copia il comando e avvisa.
if command -v wl-copy >/dev/null 2>&1; then
    printf '%s' "$COMMAND" | wl-copy || true
fi
if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Labwc Q4OS" "Comando copiato" \
        "Incollalo nel terminale con Ctrl+Shift+V e premi Invio." >/dev/null 2>&1 || true
fi
exit 1
