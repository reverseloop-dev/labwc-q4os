#!/usr/bin/env python3
"""freetube-close-overlay - pulsante X dentro FreeTube quando gira in Cage.

Cage non disegna decorazioni (e FreeTube su Wayland non ne fornisce), quindi
in modalita' Cage non ci sarebbe modo di chiudere la finestra. Questo helper
si collega al DevTools di FreeTube (gia' avviato con --remote-debugging-port=0)
e aggiunge un pulsante X in alto a destra che chiama window.close().

Uso: freetube-close-overlay /percorso/DevToolsActivePort
"""

import asyncio
import json
import sys
import urllib.request

import websockets

JS = r"""
(() => {
  if (document.getElementById('labwc-close-x')) {
    return 'exists';
  }
  const b = document.createElement('button');
  b.id = 'labwc-close-x';
  b.type = 'button';
  b.textContent = '\u2715';
  b.title = 'Chiudi FreeTube';
  b.setAttribute('aria-label', 'Chiudi FreeTube');
  b.style.cssText = [
    'position:fixed', 'top:8px', 'right:8px', 'z-index:2147483647',
    'width:40px', 'height:40px', 'border-radius:20px', 'border:0',
    'background:#c01c28', 'color:#fff', 'font:bold 22px sans-serif',
    'line-height:40px', 'padding:0', 'cursor:pointer',
    'box-shadow:0 2px 8px #0008'
  ].join(';');
  b.addEventListener('click', () => window.close());
  document.body.appendChild(b);
  return 'added';
})()
"""


def read_port(path):
    with open(path, encoding="utf-8") as f:
        return f.readline().strip()


def page_ws_url(port):
    with urllib.request.urlopen(
        f"http://127.0.0.1:{port}/json/list", timeout=3
    ) as response:
        targets = json.load(response)
    for target in targets:
        if target.get("type") == "page" and target.get("webSocketDebuggerUrl"):
            return target["webSocketDebuggerUrl"]
    return None


async def evaluate(ws, expression, msg_id):
    await ws.send(json.dumps({
        "id": msg_id,
        "method": "Runtime.evaluate",
        "params": {"expression": expression, "returnByValue": True},
    }))
    while True:
        message = json.loads(await asyncio.wait_for(ws.recv(), timeout=5))
        if message.get("id") == msg_id:
            return message


async def watch(port_file):
    msg_id = 0
    while True:
        try:
            url = page_ws_url(read_port(port_file))
            if not url:
                await asyncio.sleep(1)
                continue
            async with websockets.connect(url) as ws:
                while True:
                    msg_id += 1
                    await evaluate(ws, JS, msg_id)
                    await asyncio.sleep(2)
        except Exception:
            await asyncio.sleep(1)


if __name__ == "__main__":
    if len(sys.argv) != 2:
        raise SystemExit("uso: freetube-close-overlay DevToolsActivePort")
    try:
        asyncio.run(watch(sys.argv[1]))
    except KeyboardInterrupt:
        pass
