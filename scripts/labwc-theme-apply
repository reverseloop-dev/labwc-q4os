#!/usr/bin/env bash
# =============================================================================
#  labwc-theme-apply - applica un tema (colori, barra, launcher, notifiche)
#  Uso: labwc-theme-apply [nordic-cobalt|muted-crimson|sage-emerald]
#       labwc-theme-apply --list
#       labwc-theme-apply --no-reload <tema>
# =============================================================================
set -euo pipefail

SHARE="${LABWC_Q4OS_SHARE:-${XDG_DATA_HOME:-$HOME/.local/share}/labwc-q4os}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/labwc-q4os"
THEMES_DIR="$SHARE/themes"
TEMPLATES="$SHARE/templates"
LOGIN_CONF="$CONFIG/labwc/login.conf"
LOGIN_HELPER="/usr/local/libexec/labwc-q4os/login-theme-apply"

VALID_THEMES=(nordic-cobalt muted-crimson sage-emerald)

# Shell scelta dall'installer: in modalita' noctalia lo sfondo va via IPC,
# niente swaybg/waybar/mako. Senza marker vale il comportamento classico.
shell_mode="waybar"
if [ -r "$CONFIG/labwc/shell" ]; then
    shell_mode="$(tr -d '[:space:]' < "$CONFIG/labwc/shell")"
fi

NO_RELOAD=0
QUIET=0
THEME_ID=""

for arg in "$@"; do
    case "$arg" in
        --no-reload) NO_RELOAD=1 ;;
        --quiet) QUIET=1 ;;
        --list)
            printf '%s\n' "${VALID_THEMES[@]}"
            exit 0
            ;;
        -h|--help)
            sed -n '2,8p' "$0" | sed 's/^#  //'
            exit 0
            ;;
        -*)
            printf 'Opzione sconosciuta: %s\n' "$arg" >&2
            exit 2
            ;;
        *)
            THEME_ID="$arg"
            ;;
    esac
done

if [ -z "$THEME_ID" ]; then
    if [ -r "$CONFIG/labwc/theme" ]; then
        THEME_ID="$(tr -d '[:space:]' < "$CONFIG/labwc/theme")"
    fi
fi

if [ -z "$THEME_ID" ]; then
    THEME_ID="nordic-cobalt"
fi

valid=0
for t in "${VALID_THEMES[@]}"; do
    [ "$t" = "$THEME_ID" ] && valid=1
done
if [ "$valid" -ne 1 ]; then
    printf 'Tema non valido: %s\nTemi disponibili: %s\n' "$THEME_ID" "${VALID_THEMES[*]}" >&2
    exit 2
fi

THEME_FILE="$THEMES_DIR/$THEME_ID/theme.conf"
[ -r "$THEME_FILE" ] || { printf 'Tema non trovato: %s\n' "$THEME_FILE" >&2; exit 1; }

# shellcheck disable=SC1090
. "$THEME_FILE"

for required in BG SURFACE ACCENT FG BORDER WALLPAPER; do
    if [ -z "${!required:-}" ]; then
        printf 'Tema incompleto: manca %s in %s\n' "$required" "$THEME_FILE" >&2
        exit 1
    fi
done

ICON_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/icons"
ICON_THEME_PATH="$ICON_ROOT/labwc-q4os"
mkdir -p "$CONFIG/labwc" "$CONFIG/waybar" "$CONFIG/fuzzel" "$CONFIG/mako" "$CONFIG/wlogout" "$STATE" "$ICON_ROOT"

render() {
    local src="$1" dst="$2"
    [ -r "$src" ] || { printf 'Template mancante: %s\n' "$src" >&2; return 1; }
    mkdir -p "$(dirname "$dst")"
    sed \
        -e "s|@@THEME_ID@@|$THEME_ID|g" \
        -e "s|@@THEME_NAME@@|$THEME_NAME|g" \
        -e "s|@@BG@@|$BG|g" \
        -e "s|@@BG_ALT@@|$BG_ALT|g" \
        -e "s|@@SURFACE@@|$SURFACE|g" \
        -e "s|@@SURFACE_ALT@@|$SURFACE_ALT|g" \
        -e "s|@@SURFACE_HOVER@@|$SURFACE_HOVER|g" \
        -e "s|@@ACCENT@@|$ACCENT|g" \
        -e "s|@@ACCENT_SOFT@@|$ACCENT_SOFT|g" \
        -e "s|@@ACCENT_DEEP@@|$ACCENT_DEEP|g" \
        -e "s|@@FG@@|$FG|g" \
        -e "s|@@FG_MUTED@@|$FG_MUTED|g" \
        -e "s|@@BORDER@@|$BORDER|g" \
        -e "s|@@DANGER@@|$DANGER|g" \
        -e "s|@@DANGER_RGB@@|$DANGER_RGB|g" \
        -e "s|@@ICON_THEME_PATH@@|$ICON_ROOT/labwc-q4os|g" \
        -e "s|@@HOME@@|$HOME|g" \
        -e "s|@@WARNING@@|$WARNING|g" \
        -e "s|@@SUCCESS@@|$SUCCESS|g" \
        -e "s|@@BG_RGB@@|$BG_RGB|g" \
        -e "s|@@SURFACE_RGB@@|$SURFACE_RGB|g" \
        -e "s|@@ACCENT_RGB@@|$ACCENT_RGB|g" \
        -e "s|@@FG_RGB@@|$FG_RGB|g" \
        -e "s|@@BORDER_RGB@@|$BORDER_RGB|g" \
        "$src" > "$dst.tmp"
    mv "$dst.tmp" "$dst"
}

# --- file di configurazione -------------------------------------------------
# La vecchia posizione ~/.config/labwc/themerc non viene letta da labwc.
# Si usa themerc-override, che sovrascrive il tema base.
if [ -f "$CONFIG/labwc/themerc" ] && grep -q 'labwc themerc -' "$CONFIG/labwc/themerc" 2>/dev/null; then
    mv -f "$CONFIG/labwc/themerc" "$CONFIG/labwc/themerc.old" 2>/dev/null || true
fi
install -m 0644 "$THEMES_DIR/$THEME_ID/themerc" "$CONFIG/labwc/themerc-override"
if [ -f "$CONFIG/labwc/touchscreen.enabled" ]; then
    # Pulsanti e voci di menu piu' grandi per il dito.
    cat >> "$CONFIG/labwc/themerc-override" <<'EOF'

# Touchscreen: bersagli piu' grandi
window.button.width: 44
window.button.height: 44
window.button.spacing: 6
window.titlebar.padding.width: 12
window.titlebar.padding.height: 10
menu.items.padding.x: 16
menu.items.padding.y: 12
menu.width.min: 260
EOF
fi
render "$TEMPLATES/waybar-style.css" "$CONFIG/waybar/style.css"
render "$TEMPLATES/fuzzel.ini" "$CONFIG/fuzzel/fuzzel.ini"
render "$TEMPLATES/mako-config" "$CONFIG/mako/config"
render "$TEMPLATES/wlogout-style.css" "$CONFIG/wlogout/style.css"

printf '%s\n' "$THEME_ID" > "$CONFIG/labwc/theme"

# Icone coordinate al tema (tema GTK "labwc-q4os"); rigenerate a ogni
# applicazione così anche le icone nuove (cartelle, cestino, azioni) entrano
# subito nel tema già installato.
if [ -x "$SHARE/scripts/generate-icons.py" ]; then
    python3 "$SHARE/scripts/generate-icons.py" \
        --theme-conf "$THEMES_DIR/$THEME_ID/theme.conf" \
        --output "$SHARE/icons" >/dev/null 2>&1 || true
fi
if [ -d "$SHARE/icons/$THEME_ID" ]; then
    if [ -L "$ICON_THEME_PATH" ] || [ ! -e "$ICON_THEME_PATH" ]; then
        ln -sfn "$SHARE/icons/$THEME_ID" "$ICON_THEME_PATH"
    elif [ -f "$ICON_THEME_PATH/.labwc-q4os-theme" ]; then
        rm -rf "$ICON_THEME_PATH"
        ln -sfn "$SHARE/icons/$THEME_ID" "$ICON_THEME_PATH"
    else
        printf 'Icon theme path occupato: %s\n' "$ICON_THEME_PATH" >&2
    fi
fi

for gtk_dir in "$CONFIG/gtk-3.0" "$CONFIG/gtk-4.0"; do
    mkdir -p "$gtk_dir"
    settings="$gtk_dir/settings.ini"
    [ -f "$settings" ] || printf '[Settings]\n' > "$settings"
    if grep -q '^gtk-icon-theme-name=' "$settings"; then
        sed -i 's/^gtk-icon-theme-name=.*/gtk-icon-theme-name=labwc-q4os/' "$settings"
    else
        printf 'gtk-icon-theme-name=labwc-q4os\n' >> "$settings"
    fi
done
# GTK3 su Wayland non legge settings.ini per le icone: il tema va impostato
# in GSettings. Senza questo PCManFM resta su Adwaita.
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface icon-theme labwc-q4os \
        >/dev/null 2>&1 || true
fi

WALLPAPER_PATH="$SHARE/wallpapers/$WALLPAPER"
if [ -f "$WALLPAPER_PATH" ]; then
    ln -sfn "$WALLPAPER_PATH" "$CONFIG/labwc/current-wallpaper.png"
fi

# --- ricarica a caldo -------------------------------------------------------
runtime_reload() {
    [ "$NO_RELOAD" -eq 1 ] && return 0
    [ -n "${WAYLAND_DISPLAY:-}" ] || return 0
    pgrep -x labwc >/dev/null 2>&1 || return 0

    mkdir -p "$STATE"

    labwc --reconfigure >/dev/null 2>&1 || pkill -HUP -x labwc >/dev/null 2>&1 || true

    if [ "$shell_mode" = "noctalia" ] && command -v noctalia >/dev/null 2>&1; then
        # IPC confermato (docs.noctalia.dev/noctalia/ipc/media-and-ui/#wallpaper):
        # wallpaper-set imposta lo sfondo; con [theme] source = "wallpaper"
        # la palette si rigenera da sola. Mai bloccare il cambio tema.
        if pgrep -x noctalia >/dev/null 2>&1 && [ -f "$WALLPAPER_PATH" ]; then
            timeout 2 noctalia msg wallpaper-set "$WALLPAPER_PATH" >>"$STATE/session.log" 2>&1 || true
        fi
        return 0
    fi

    # Modalita' Waybar (o fallback): una sola shell attiva.
    pkill -x noctalia >/dev/null 2>&1 || true

    if [ -f "$WALLPAPER_PATH" ] && command -v swaybg >/dev/null 2>&1; then
        if pkill -x swaybg >/dev/null 2>&1; then sleep 0.15; fi
        setsid -f swaybg -m fill -i "$WALLPAPER_PATH" >>"$STATE/session.log" 2>&1 || true
    fi

    if command -v waybar >/dev/null 2>&1; then
        if pkill -x waybar >/dev/null 2>&1; then sleep 0.25; fi
        setsid -f waybar -c "$CONFIG/waybar/config.jsonc" -s "$CONFIG/waybar/style.css" \
            >>"$STATE/session.log" 2>&1 || true
    fi

    if pgrep -x mako >/dev/null 2>&1 && command -v makoctl >/dev/null 2>&1; then
        makoctl reload >/dev/null 2>&1 || true
    fi
}

set_login_conf() {
    local follow="$1" variant="$2" tmp
    mkdir -p "$CONFIG/labwc"
    tmp="$(mktemp)"
    if [ -r "$LOGIN_CONF" ]; then
        grep -vE '^(follow_theme|variant)=' "$LOGIN_CONF" > "$tmp" || true
    fi
    printf 'follow_theme=%s\nvariant=%s\n' "$follow" "$variant" >> "$tmp"
    install -m 0644 "$tmp" "$LOGIN_CONF"
    rm -f "$tmp"
}

# Se il login segue il tema del desktop, porta colori e layout anche su SDDM.
sync_login_theme() {
    local follow=1
    if [ -r "$LOGIN_CONF" ] && grep -q '^follow_theme=0' "$LOGIN_CONF"; then
        follow=0
    fi
    [ "$follow" -eq 1 ] || return 0
    set_login_conf 1 "$THEME_ID"
    [ "${LABWC_Q4OS_SKIP_LOGIN:-0}" = "1" ] && return 0
    if [ ! -x "$LOGIN_HELPER" ]; then
        [ "$QUIET" -eq 1 ] || printf 'Tema login non sincronizzato: helper mancante (esegui install.sh).\n' >&2
        return 0
    fi
    if [ "$(id -u)" -eq 0 ]; then
        "$LOGIN_HELPER" "$THEME_ID" || [ "$QUIET" -eq 1 ] || printf 'Tema login non applicato.\n' >&2
    elif command -v pkexec >/dev/null 2>&1; then
        pkexec "$LOGIN_HELPER" "$THEME_ID" ||
            [ "$QUIET" -eq 1 ] || printf 'Tema login non applicato (autorizzazione annullata?).\n' >&2
    elif [ "$QUIET" -eq 1 ]; then
        :
    else
        printf 'Tema login non sincronizzato: pkexec mancante.\n' >&2
    fi
}

runtime_reload

# Il login si sincronizza dopo il desktop: se pkexec viene annullato i colori
# del desktop sono comunque già applicati.
sync_login_theme

if [ "$QUIET" -eq 0 ] && [ "$NO_RELOAD" -eq 0 ] && [ -n "${WAYLAND_DISPLAY:-}" ] && command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Labwc" -i "$WALLPAPER_PATH" "Tema attivo: $THEME_NAME" "Colori, Waybar, Fuzzel e sfondo aggiornati" || true
fi

if [ "$QUIET" -eq 0 ]; then
    printf 'Tema applicato: %s (%s)\n' "$THEME_NAME" "$THEME_LABEL"
fi
