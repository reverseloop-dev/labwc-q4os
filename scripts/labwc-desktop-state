#!/usr/bin/env bash
# =============================================================================
#  labwc-desktop-state - aggiorna lo stato del desktop corrente
#  Uso: labwc-desktop-state {1|2|3|4|next|prev}
# =============================================================================
set -uo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/labwc-q4os"
mkdir -p "$STATE"
current="$(cat "$STATE/desktop" 2>/dev/null || echo 1)"
case "$current" in 1|2|3|4) ;; *) current=1 ;; esac

case "${1:-}" in
    1|2|3|4) current="$1" ;;
    next) current=$(( current % 4 + 1 )) ;;
    prev) current=$(( (current + 2) % 4 + 1 )) ;;
    *) exit 0 ;;
esac
printf '%s\n' "$current" > "$STATE/desktop"
