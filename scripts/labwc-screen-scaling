#!/usr/bin/env python3
"""labwc-screen-scaling - scala risoluzione e dimensioni dei monitor in labwc.

Finestra GTK per scegliere monitor, scala (1.0, 1.25, 1.5, ...) e risoluzione.
Usa wlr-randr (wlr-output-management di labwc). Con "Rendi permanente" salva la
scelta in ~/.config/labwc/screen-scale.conf; labwc-session-start la riapplica
al prossimo login. "Ripristina" torna a scala 1.0 e al modo preferito.

Uso: labwc-screen-scaling [--apply-from-config] [--self-test] [--version]
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

VERSION = "1"
HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
SHARE = Path(
    os.environ.get(
        "LABWC_Q4OS_SHARE",
        Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))
        / "labwc-q4os",
    )
)
STATE_CONF = CONFIG / "labwc/screen-scale.conf"
THEME_FILE = CONFIG / "labwc/theme"
SCALES = ("1.0", "1.25", "1.5", "1.75", "2.0")

DEFAULT_COLORS = {
    "BG": "070d1a",
    "SURFACE": "1e293b",
    "SURFACE_ALT": "273449",
    "ACCENT": "3b82f6",
    "ACCENT_SOFT": "60a5fa",
    "FG": "e2e8f0",
    "FG_MUTED": "94a3b8",
    "BORDER": "334155",
}


def hex_rgb(value: str):
    value = value.strip().lstrip("#")
    if len(value) != 6:
        return (1.0, 1.0, 1.0)
    try:
        return tuple(int(value[i:i + 2], 16) / 255.0 for i in (0, 2, 4))
    except ValueError:
        return (1.0, 1.0, 1.0)


def theme_colors():
    theme = "nordic-cobalt"
    try:
        value = THEME_FILE.read_text(encoding="utf-8").strip()
        if value:
            theme = value
    except OSError:
        pass
    data = dict(DEFAULT_COLORS)
    conf = SHARE / "themes" / theme / "theme.conf"
    try:
        for raw in conf.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            value = value.strip().strip('"')
            if key in data and len(value.lstrip("#")) == 6:
                data[key] = value
    except OSError:
        pass
    return data


def mode_id(width: int, height: int, refresh_hz: float) -> str:
    refresh = f"{float(refresh_hz):.3f}".rstrip("0").rstrip(".")
    return f"{width}x{height}@{refresh}"


def parse_json_outputs(raw: str):
    """Trasforma `wlr-randr --json` in una lista di monitor normalizzati."""
    data = json.loads(raw)
    outputs = []
    for item in data:
        name = str(item.get("name", "")).strip()
        if not name:
            continue
        modes = []
        current_mode = ""
        preferred_mode = ""
        for mode in item.get("modes") or []:
            try:
                width = int(mode["width"])
                height = int(mode["height"])
                refresh = float(mode.get("refresh", 0)) / 1000.0
            except (KeyError, TypeError, ValueError):
                continue
            mode_entry = {
                "id": mode_id(width, height, refresh),
                "width": width,
                "height": height,
                "refresh": refresh,
                "preferred": bool(mode.get("preferred")),
                "current": bool(mode.get("current")),
            }
            modes.append(mode_entry)
            if mode_entry["current"]:
                current_mode = mode_entry["id"]
            if mode_entry["preferred"]:
                preferred_mode = mode_entry["id"]
        try:
            scale = float(item.get("scale", 1.0))
        except (TypeError, ValueError):
            scale = 1.0
        outputs.append({
            "name": name,
            "enabled": bool(item.get("enabled", True)),
            "scale": scale,
            "modes": modes,
            "current": current_mode or (modes[0]["id"] if modes else ""),
            "preferred": preferred_mode or (modes[0]["id"] if modes else ""),
        })
    return outputs


TEXT_MODE = re.compile(
    r"^\s+(\d+)x(\d+)\s+px,\s+([\d.]+)\s+Hz(.*)$"
)
TEXT_OUTPUT = re.compile(r'^(\S+)(?:\s+"([^"]*)")?$')


def parse_text_outputs(raw: str):
    """Fallback per wlr-randr senza --json."""
    outputs = []
    current = None
    for line in raw.splitlines():
        if not line.strip():
            continue
        match = TEXT_MODE.match(line)
        if match and current is not None:
            width, height = int(match.group(1)), int(match.group(2))
            refresh = float(match.group(3))
            flags = match.group(4)
            entry = {
                "id": mode_id(width, height, refresh),
                "width": width,
                "height": height,
                "refresh": refresh,
                "preferred": "preferred" in flags,
                "current": "current" in flags,
            }
            current["modes"].append(entry)
            if entry["current"]:
                current["current"] = entry["id"]
            if entry["preferred"]:
                current["preferred"] = entry["id"]
            continue
        if line[0].isspace():
            stripped = line.strip()
            if current is not None and stripped.lower().startswith("scale:"):
                try:
                    current["scale"] = float(stripped.split(":", 1)[1].strip())
                except ValueError:
                    pass
            continue
        match = TEXT_OUTPUT.match(line.strip())
        if match:
            current = {
                "name": match.group(1),
                "enabled": True,
                "scale": 1.0,
                "modes": [],
                "current": "",
                "preferred": "",
            }
            outputs.append(current)
    for output in outputs:
        if not output["current"] and output["modes"]:
            output["current"] = output["modes"][0]["id"]
        if not output["preferred"] and output["modes"]:
            output["preferred"] = output["modes"][0]["id"]
    return outputs


def read_outputs():
    if not shutil.which("wlr-randr"):
        raise RuntimeError(
            "wlr-randr non installato: esegui install.sh (pacchetto wlr-randr)."
        )
    proc = subprocess.run(
        ["wlr-randr", "--json"], capture_output=True, text=True, check=False
    )
    if proc.returncode == 0 and proc.stdout.strip():
        try:
            return parse_json_outputs(proc.stdout)
        except (ValueError, TypeError):
            pass
    proc = subprocess.run(["wlr-randr"], capture_output=True, text=True, check=False)
    if proc.returncode != 0:
        message = (proc.stderr or proc.stdout or "").strip().splitlines()
        raise RuntimeError(message[-1] if message else "wlr-randr non risponde.")
    return parse_text_outputs(proc.stdout)


def run_randr(arguments):
    proc = subprocess.run(
        ["wlr-randr", *arguments], capture_output=True, text=True, check=False
    )
    if proc.returncode != 0:
        message = (proc.stderr or proc.stdout or "").strip().splitlines()
        raise RuntimeError(message[-1] if message else "wlr-randr ha fallito.")
    return proc.stdout


def read_state():
    state = {}
    try:
        for raw in STATE_CONF.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            state[key.strip()] = value.strip()
    except OSError:
        pass
    return state


def write_state(output: str, scale: str, mode: str) -> None:
    STATE_CONF.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE_CONF.with_name(STATE_CONF.name + ".tmp")
    tmp.write_text(
        "# gestito da labwc-screen-scaling\n"
        f"output={output}\n"
        f"scale={scale}\n"
        f"mode={mode}\n",
        encoding="utf-8",
    )
    os.replace(tmp, STATE_CONF)


def clear_state() -> None:
    try:
        STATE_CONF.unlink()
    except OSError:
        pass


def commands_for(output: str, scale: str, mode: str):
    commands = [["--output", output, "--scale", scale]]
    if mode == "preferred":
        commands[0].append("--preferred")
    elif mode:
        commands[0].extend(["--mode", mode])
    return commands[0]


def apply_from_config() -> int:
    state = read_state()
    output = state.get("output", "")
    scale = state.get("scale", "1.0")
    mode = state.get("mode", "preferred")
    if not output or not shutil.which("wlr-randr"):
        return 0
    try:
        run_randr(commands_for(output, scale, mode))
    except RuntimeError as exc:
        print(f"labwc-screen-scaling: {exc}", file=sys.stderr)
        return 1
    return 0


def self_test() -> int:
    fixture = json.dumps([
        {
            "name": "eDP-1",
            "enabled": True,
            "scale": 1.25,
            "modes": [
                {"width": 1920, "height": 1080, "refresh": 60000,
                 "preferred": True, "current": True},
                {"width": 1280, "height": 720, "refresh": 59940,
                 "preferred": False, "current": False},
            ],
        },
        {"name": "HDMI-A-1", "enabled": False, "modes": []},
    ])
    outputs = parse_json_outputs(fixture)
    assert len(outputs) == 2, "numero monitor"
    assert outputs[0]["name"] == "eDP-1", "nome monitor"
    assert outputs[0]["scale"] == 1.25, "scala"
    assert outputs[0]["current"] == "1920x1080@60", "modo corrente"
    assert outputs[0]["preferred"] == "1920x1080@60", "modo preferito"
    assert outputs[0]["modes"][1]["id"] == "1280x720@59.94", "modo secondario"

    text_fixture = (
        'eDP-1 "Built-in display"\n'
        "  1920x1080 px, 60.000000 Hz (preferred, current)\n"
        "  1280x720 px, 59.940000 Hz\n"
        "  Scale: 1.250000\n"
    )
    text_outputs = parse_text_outputs(text_fixture)
    assert text_outputs[0]["name"] == "eDP-1", "parse testuale nome"
    assert text_outputs[0]["current"] == "1920x1080@60", "parse testuale modo"
    assert abs(text_outputs[0]["scale"] - 1.25) < 0.001, "parse testuale scala"
    assert commands_for("eDP-1", "1.5", "preferred")[-1] == "--preferred", "comando"
    print("SELFTEST_OK")
    return 0


class ScreenScaling:
    def __init__(self) -> None:
        import gi

        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gdk, GLib, Gtk

        self.GLib = GLib
        self.Gtk = Gtk
        self.outputs = []
        self.error = ""
        self.c = theme_colors()

        provider = Gtk.CssProvider()
        provider.load_from_data(self.css().encode("utf-8"))
        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        self.win = Gtk.Window(title="Scala dimensioni dello schermo")
        self.win.set_default_size(620, 420)
        self.win.set_border_width(16)
        self.win.set_position(Gtk.WindowPosition.CENTER)
        self.win.set_icon_name("preferences-desktop-display")
        self.win.connect("destroy", Gtk.main_quit)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.win.add(outer)

        title = Gtk.Label(label="Scala dimensioni dello schermo", xalign=0)
        title.get_style_context().add_class("title")
        subtitle = Gtk.Label(
            label="Monitor, risoluzione e scala. Le modifiche sono immediate.", xalign=0
        )
        subtitle.get_style_context().add_class("subtitle")
        outer.pack_start(title, False, False, 0)
        outer.pack_start(subtitle, False, False, 0)

        screen_box = self.card("SCHERMO", "Scegli il monitor e applica la scala.")
        self.output = Gtk.ComboBoxText()
        self.output.connect("changed", self.on_output)
        screen_box.pack_start(self.labeled("Monitor", self.output), False, False, 0)

        self.info = Gtk.Label(label="", xalign=0)
        self.info.get_style_context().add_class("card-hint")
        screen_box.pack_start(self.info, False, False, 0)

        self.scale = Gtk.ComboBoxText()
        for value in SCALES:
            self.scale.append_text(value)
        self.scale.connect("changed", self.on_scale_preset)
        self.scale_entry = Gtk.Entry()
        self.scale_entry.set_width_chars(8)
        scale_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        scale_row.pack_start(self.label("Scala", 0), False, False, 0)
        scale_row.pack_start(self.scale, False, False, 0)
        scale_row.pack_start(self.scale_entry, False, False, 0)
        screen_box.pack_start(scale_row, False, False, 0)

        self.mode = Gtk.ComboBoxText()
        screen_box.pack_start(
            self.labeled("Risoluzione", self.mode), False, False, 0
        )
        outer.pack_start(screen_box, False, False, 0)

        perm_box = self.card(
            "PERMANENZA",
            "Se attivo, la scelta viene riapplicata al prossimo login.",
        )
        self.permanent = Gtk.Switch()
        self.permanent.set_active(STATE_CONF.is_file())
        self.permanent.set_halign(Gtk.Align.END)
        perm_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        perm_row.pack_start(
            self.label("Rendi permanente", 0), True, True, 0
        )
        perm_row.pack_end(self.permanent, False, False, 0)
        perm_box.pack_start(perm_row, False, False, 0)
        outer.pack_start(perm_box, False, False, 0)

        self.status = Gtk.Label(label="", xalign=0)
        self.status.get_style_context().add_class("status")
        outer.pack_start(self.status, False, False, 0)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        apply_button = Gtk.Button(label="Applica")
        apply_button.connect("clicked", lambda _b: self.apply())
        reset_button = Gtk.Button(label="Ripristina (1.0 + preferita)")
        reset_button.connect("clicked", lambda _b: self.reset())
        close_button = Gtk.Button(label="Chiudi")
        close_button.connect("clicked", lambda _b: self.win.destroy())
        buttons.pack_start(reset_button, False, False, 0)
        buttons.pack_end(close_button, False, False, 0)
        buttons.pack_end(apply_button, False, False, 0)
        outer.pack_end(buttons, False, False, 0)

        self.win.show_all()
        self.reload_outputs()

    def css(self) -> str:
        c = self.c
        return f"""
        window {{ background-color: #{c['BG']}; color: #{c['FG']}; }}
        .title {{ font-size: 24px; font-weight: 700; }}
        .subtitle {{ color: #{c['FG_MUTED']}; font-size: 12px; }}
        .card {{ background-color: #{c['SURFACE']}; border: 1px solid #{c['BORDER']};
                 border-radius: 14px; padding: 14px; }}
        .card-title {{ color: #{c['ACCENT_SOFT']}; font-size: 11px;
                       font-weight: 700; letter-spacing: 1px; }}
        .card-hint {{ color: #{c['FG_MUTED']}; font-size: 11px; }}
        .status {{ color: #{c['ACCENT_SOFT']}; font-size: 12px; font-weight: 600; }}
        button {{ background-image: none; background-color: #{c['SURFACE_ALT']};
                  color: #{c['FG']}; border: 1px solid #{c['BORDER']};
                  border-radius: 9px; padding: 8px 14px; font-weight: 600; }}
        button label {{ color: #{c['FG']}; }}
        button:hover {{ background-image: none; border-color: #{c['ACCENT']}; }}
        entry, combobox, combobox button {{
            background-image: none; color: #{c['FG']};
            background-color: #{c['SURFACE_ALT']};
            border: 1px solid #{c['BORDER']}; border-radius: 8px;
        }}
        """

    def card(self, title: str, hint: str):
        Gtk = self.Gtk
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.get_style_context().add_class("card")
        heading = Gtk.Label(label=title, xalign=0)
        heading.get_style_context().add_class("card-title")
        text = Gtk.Label(label=hint, xalign=0)
        text.set_line_wrap(True)
        text.get_style_context().add_class("card-hint")
        box.pack_start(heading, False, False, 0)
        box.pack_start(text, False, False, 0)
        return box

    def label(self, text: str, width: int = 130):
        label = self.Gtk.Label(label=text, xalign=0)
        if width:
            label.set_size_request(width, -1)
        return label

    def labeled(self, text: str, widget):
        row = self.Gtk.Box(orientation=self.Gtk.Orientation.HORIZONTAL, spacing=8)
        row.pack_start(self.label(text), False, False, 0)
        row.pack_start(widget, False, False, 0)
        return row

    def reload_outputs(self) -> None:
        try:
            self.outputs = [o for o in read_outputs() if o["enabled"]]
            self.error = ""
        except RuntimeError as exc:
            self.outputs = []
            self.error = str(exc)
        self.output.remove_all()
        for output in self.outputs:
            self.output.append(output["name"], output["name"])
        if self.outputs:
            self.output.set_active(0)
            self.status.set_text(
                "Pronto." if not self.error else self.error
            )
        else:
            self.info.set_text("")
            self.status.set_text(self.error or "Nessun monitor rilevato.")
            self.apply_button_sensitive(False)

    def apply_button_sensitive(self, enabled: bool) -> None:
        # I pulsanti restano cliccabili per mostrare l'errore; solo i campi
        # vengono disabilitati.
        self.scale.set_sensitive(enabled)
        self.scale_entry.set_sensitive(enabled)
        self.mode.set_sensitive(enabled)

    def current(self):
        name = self.output.get_active_id()
        for output in self.outputs:
            if output["name"] == name:
                return output
        return self.outputs[0] if self.outputs else None

    def on_output(self, _widget=None) -> None:
        output = self.current()
        if output is None:
            return
        self.scale_entry.set_text(f"{output['scale']:g}")
        preset = f"{output['scale']:g}"
        if preset in SCALES:
            self.scale.set_active(SCALES.index(preset))
        else:
            self.scale.set_active(-1)
        self.mode.remove_all()
        self.mode.append("preferred", "Preferita")
        for mode in output["modes"]:
            self.mode.append(mode["id"], mode["id"])
        self.mode.set_active_id(output["current"] or "preferred")
        self.info.set_text(
            f"Corrente: {output['current'] or '?'} · scala {output['scale']:g}"
        )
        self.apply_button_sensitive(True)

    def on_scale_preset(self, _widget=None) -> None:
        preset = self.scale.get_active_text()
        if preset:
            self.scale_entry.set_text(preset)

    def read_scale(self) -> str:
        text = self.scale_entry.get_text().strip().replace(",", ".")
        try:
            value = float(text)
        except ValueError:
            raise RuntimeError("Scala non valida: usa un numero, per esempio 1.25.")
        if not 0.5 <= value <= 4.0:
            raise RuntimeError("Scala fuori intervallo: usa un valore tra 0.5 e 4.0.")
        return f"{value:g}"

    def apply(self) -> None:
        output = self.current()
        if output is None:
            self.status.set_text(self.error or "Nessun monitor disponibile.")
            return
        try:
            scale = self.read_scale()
            mode = self.mode.get_active_id() or "preferred"
            run_randr(commands_for(output["name"], scale, mode))
        except RuntimeError as exc:
            self.status.set_text(str(exc))
            return
        if self.permanent.get_active():
            try:
                write_state(output["name"], scale, mode)
            except OSError as exc:
                self.status.set_text(f"Scala applicata, ma non salvata: {exc}")
                return
        else:
            clear_state()
        self.status.set_text(
            f"Applicato: {output['name']} · {scale}× · {mode}"
        )
        self.GLib.timeout_add(800, self.refresh_after_change)

    def refresh_after_change(self) -> bool:
        self.reload_outputs()
        return False

    def reset(self) -> None:
        output = self.current()
        if output is None:
            self.status.set_text(self.error or "Nessun monitor disponibile.")
            return
        try:
            run_randr(
                ["--output", output["name"], "--scale", "1", "--preferred"]
            )
        except RuntimeError as exc:
            self.status.set_text(str(exc))
            return
        clear_state()
        self.status.set_text(f"Ripristinato: {output['name']} · scala 1.0")
        self.GLib.timeout_add(800, self.refresh_after_change)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="labwc-screen-scaling",
        description="Scala risoluzione e dimensioni dei monitor in labwc.",
    )
    parser.add_argument(
        "--apply-from-config", action="store_true",
        help="applica la scala salvata e esci (usato all'avvio sessione)",
    )
    parser.add_argument(
        "--list", action="store_true",
        help="elenca monitor e modi rilevati",
    )
    parser.add_argument(
        "--self-test", action="store_true",
        help="test interno del parser, senza display",
    )
    parser.add_argument(
        "--version", action="version", version=f"labwc-screen-scaling {VERSION}",
    )
    return parser


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    if args.self_test:
        return self_test()
    if args.apply_from_config:
        return apply_from_config()
    if args.list:
        try:
            outputs = read_outputs()
        except RuntimeError as exc:
            print(f"labwc-screen-scaling: {exc}", file=sys.stderr)
            return 1
        for output in outputs:
            print(f"{output['name']}  scala {output['scale']:g}  "
                  f"modo {output['current'] or '?'}")
            for mode in output["modes"]:
                print(f"  {mode['id']}")
        return 0
    try:
        app = ScreenScaling()
    except Exception as exc:
        print(f"labwc-screen-scaling: {exc}", file=sys.stderr)
        return 1
    try:
        app.Gtk.main()
    except KeyboardInterrupt:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
