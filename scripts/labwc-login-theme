#!/usr/bin/env python3
"""
labwc-login-theme - sceglie la schermata di login (SDDM) di labwc-q4os.

Tre temi completi, ognuno con layout e stile diversi:
  nordic-cobalt  Aurora Card  (blu, card centrale)
  muted-crimson  Split Studio (rosso, pannello laterale)
  sage-emerald   Bottom Dock  (verde, barra in basso)

Lo switch "Usa i colori dello sfondo" fa seguire al login il tema del desktop
(blu/rosso/verde scelto in Preferenze o dal cambio sfondo).

Uso:
  labwc-login-theme                     interfaccia grafica
  labwc-login-theme --show              stato in JSON
  labwc-login-theme --variant ID        imposta la variante (follow=0)
  labwc-login-theme --follow 0|1        imposta/leva lo switch
  labwc-login-theme --apply [ID]        applica al login (pkexec)
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
SHARE = Path(
    os.environ.get(
        "LABWC_Q4OS_SHARE",
        Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "labwc-q4os",
    )
)
LOGIN_CONF = CONFIG / "labwc/login.conf"
THEME_FILE = CONFIG / "labwc/theme"
ROOT_HELPER = Path("/usr/local/libexec/labwc-q4os/login-theme-apply")

VARIANTS = (
    ("nordic-cobalt", "Aurora Card", "Blu · card centrale", "blu"),
    ("muted-crimson", "Split Studio", "Rosso · pannello laterale", "rosso"),
    ("sage-emerald", "Bottom Dock", "Verde · barra in basso", "verde"),
)
IDS = [v[0] for v in VARIANTS]


def desktop_theme() -> str:
    try:
        value = THEME_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        value = ""
    return value if value in IDS else "nordic-cobalt"


def read_login() -> dict[str, object]:
    data: dict[str, object] = {"follow_theme": True, "variant": desktop_theme()}
    try:
        for raw in LOGIN_CONF.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if line.startswith("follow_theme="):
                data["follow_theme"] = line.split("=", 1)[1].strip() != "0"
            elif line.startswith("variant="):
                value = line.split("=", 1)[1].strip()
                if value in IDS:
                    data["variant"] = value
    except OSError:
        pass
    return data


def write_login(follow: bool, variant: str) -> None:
    if variant not in IDS:
        raise ValueError(f"variante non valida: {variant}")
    LOGIN_CONF.parent.mkdir(parents=True, exist_ok=True)
    extra = ""
    try:
        for raw in LOGIN_CONF.read_text(encoding="utf-8").splitlines():
            if not raw.strip().startswith(("follow_theme=", "variant=")):
                extra += raw + "\n"
    except OSError:
        pass
    LOGIN_CONF.write_text(
        f"{extra}follow_theme={1 if follow else 0}\nvariant={variant}\n",
        encoding="utf-8",
    )


_COLOR_CACHE: dict[str, dict[str, str]] = {}


def theme_colors(variant: str) -> dict[str, str]:
    if variant in _COLOR_CACHE:
        return dict(_COLOR_CACHE[variant])
    colors = {
        "BG": "070d1a",
        "SURFACE": "1e293b",
        "SURFACE_ALT": "273449",
        "ACCENT": "3b82f6",
        "ACCENT_SOFT": "60a5fa",
        "FG": "e2e8f0",
        "FG_MUTED": "94a3b8",
        "BORDER": "334155",
    }
    path = SHARE / "themes" / variant / "theme.conf"
    if path.is_file():
        try:
            for raw in path.read_text(encoding="utf-8").splitlines():
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                value = value.strip().strip('"').strip("'").lstrip("#")
                if key in colors and value:
                    colors[key] = value
        except OSError:
            pass
    _COLOR_CACHE[variant] = dict(colors)
    return colors


def apply_variant(variant: str) -> tuple[bool, str]:
    """Applica il tema al login. pkexec chiede la password nella GUI."""
    if variant not in IDS:
        return False, f"Variante non valida: {variant}"
    if not ROOT_HELPER.is_file():
        return False, "Helper login mancante: esegui install.sh."
    command = [str(ROOT_HELPER), variant]
    if os.geteuid() != 0:
        if not shutil.which("pkexec"):
            return False, "pkexec non disponibile: impossibile chiedere la password."
        command = ["pkexec", str(ROOT_HELPER), variant]
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    detail = (result.stdout or result.stderr or "").strip().splitlines()
    message = detail[-1] if detail else ""
    if result.returncode == 0:
        return True, message or f"Tema login applicato: {variant}"
    if result.returncode in (126, 127):
        return False, "Autorizzazione annullata."
    return False, message or f"Applicazione non riuscita (codice {result.returncode})."


def print_state() -> int:
    state = read_login()
    print(
        json.dumps(
            {
                "follow_theme": state["follow_theme"],
                "variant": state["variant"],
                "desktop_theme": desktop_theme(),
                "helper": str(ROOT_HELPER),
                "variants": IDS,
            },
            ensure_ascii=False,
        )
    )
    return 0


def cli(args: list[str]) -> int:
    if "-h" in args or "--help" in args:
        print(__doc__.strip())
        return 0
    state = read_login()
    if "--show" in args:
        return print_state()
    if "--variant" in args:
        index = args.index("--variant")
        if index + 1 >= len(args):
            print("--variant richiede un ID", file=sys.stderr)
            return 2
        variant = args[index + 1]
        if variant not in IDS:
            print(f"Varianti: {', '.join(IDS)}", file=sys.stderr)
            return 2
        write_login(False, variant)
        print(f"Variante login: {variant} (segui desktop disattivato)")
        return 0
    if "--follow" in args:
        index = args.index("--follow")
        if index + 1 >= len(args) or args[index + 1] not in ("0", "1"):
            print("--follow richiede 0 o 1", file=sys.stderr)
            return 2
        follow = args[index + 1] == "1"
        variant = desktop_theme() if follow else str(state["variant"])
        write_login(follow, variant)
        if follow:
            ok, message = apply_variant(variant)
            print(message, file=sys.stdout if ok else sys.stderr)
            return 0 if ok else 1
        print("Login non segue più lo sfondo del desktop")
        return 0
    if "--apply" in args:
        index = args.index("--apply")
        explicit = args[index + 1] if index + 1 < len(args) else ""
        if explicit:
            if explicit not in IDS:
                print(f"Varianti: {', '.join(IDS)}", file=sys.stderr)
                return 2
            variant = explicit
        elif state["follow_theme"]:
            variant = desktop_theme()
        else:
            variant = str(state["variant"])
        ok, message = apply_variant(variant)
        if ok:
            write_login(bool(state["follow_theme"]) and not explicit, variant)
        print(message, file=sys.stdout if ok else sys.stderr)
        return 0 if ok else 1
    print(f"Opzione sconosciuta. Usa --help.\nVarianti: {', '.join(IDS)}", file=sys.stderr)
    return 2


def gui() -> int:
    try:
        import gi

        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gdk, GLib, Gtk
    except (ImportError, ValueError) as exc:
        print(f"GTK3/PyGObject non disponibile: {exc}", file=sys.stderr)
        return 1

    color = theme_colors(desktop_theme())
    provider = Gtk.CssProvider()
    provider.load_from_data(
        f"""
        window {{ background-color: #{color['BG']}; color: #{color['FG']}; }}
        .title {{ font-size: 24px; font-weight: 700; }}
        .subtitle {{ color: #{color['FG_MUTED']}; font-size: 12px; }}
        .card {{ background-color: #{color['SURFACE']}; border: 1px solid #{color['BORDER']};
                 border-radius: 14px; padding: 12px; }}
        .status {{ color: #{color['ACCENT_SOFT']}; font-size: 12px; font-weight: 600; }}
        .preview-nordic-cobalt {{ background-image: linear-gradient(to bottom right,
                  #{color['BG']}, #1e3a5f); border-radius: 8px; color: #93c5fd; }}
        .preview-muted-crimson {{ background-image: linear-gradient(to bottom right,
                  #1b1114, #5a2b2f); border-radius: 8px; color: #f1b5b8; }}
        .preview-sage-emerald {{ background-image: linear-gradient(to bottom right,
                  #101b18, #2f5d4a); border-radius: 8px; color: #a7d8c2; }}
        button {{ background-image: none; background-color: #{color['SURFACE_ALT']};
                  color: #{color['FG']}; border: 1px solid #{color['BORDER']};
                  border-radius: 10px; padding: 8px 14px; font-weight: 600; }}
        button label {{ color: #{color['FG']}; }}
        button:hover {{ border-color: #{color['ACCENT']}; }}
        button.suggested {{ background-color: #{color['ACCENT']}; color: #{color['BG']}; }}
        button.suggested label {{ color: #{color['BG']}; }}
        button:disabled {{ border-color: #{color['BORDER']}; }}
        button:disabled label {{ color: #{color['FG_MUTED']}; }}
        checkbutton, switch {{ color: #{color['FG']}; }}
        """.encode("utf-8")
    )
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    state = read_login()

    window = Gtk.Window(title="Labwc Q4OS — schermata di login")
    window.set_default_size(880, 540)
    window.set_border_width(16)
    window.set_position(Gtk.WindowPosition.CENTER)
    window.set_icon_name("preferences-desktop-theme")

    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    window.add(outer)

    title = Gtk.Label(label="Schermata di login", xalign=0)
    title.get_style_context().add_class("title")
    subtitle = Gtk.Label(
        label="Tre temi con layout diversi. Il cambio si applica al prossimo login.",
        xalign=0,
    )
    subtitle.set_line_wrap(True)
    subtitle.get_style_context().add_class("subtitle")
    outer.pack_start(title, False, False, 0)
    outer.pack_start(subtitle, False, False, 0)

    previews = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    outer.pack_start(previews, False, False, 0)

    buttons: dict[str, Gtk.ToggleButton] = {}
    try:
        gi.require_foreign("cairo")
        import cairo  # noqa: F401  (serve al disegno delle anteprime)
        have_cairo = True
    except (ImportError, ValueError):
        have_cairo = False
    for variant_id, name, description, _label in VARIANTS:
        button = Gtk.ToggleButton()
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.get_style_context().add_class("card")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        if have_cairo:
            drawing = Gtk.DrawingArea()
            drawing.set_size_request(250, 140)
            drawing.connect("draw", draw_preview, variant_id)
        else:
            drawing = Gtk.Label(label=name)
            drawing.set_size_request(250, 140)
            drawing.get_style_context().add_class(f"preview-{variant_id}")
        box.pack_start(drawing, False, False, 0)
        heading = Gtk.Label(label=name, xalign=0)
        heading.set_markup(f"<b>{name}</b>")
        detail = Gtk.Label(label=description, xalign=0)
        detail.get_style_context().add_class("subtitle")
        box.pack_start(heading, False, False, 0)
        box.pack_start(detail, False, False, 0)
        button.add(box)
        previews.pack_start(button, True, True, 0)
        buttons[variant_id] = button

    follow_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    follow_label = Gtk.Label(label="Usa i colori dello sfondo del desktop", xalign=0)
    follow_switch = Gtk.Switch()
    follow_switch.set_active(bool(state["follow_theme"]))
    follow_row.pack_start(follow_label, True, True, 0)
    follow_row.pack_end(follow_switch, False, False, 0)
    outer.pack_start(follow_row, False, False, 0)

    status = Gtk.Label(label="", xalign=0)
    status.set_line_wrap(True)
    status.get_style_context().add_class("status")
    outer.pack_start(status, False, False, 0)

    actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    apply_button = Gtk.Button(label="Applica al login")
    apply_button.get_style_context().add_class("suggested")
    close_button = Gtk.Button(label="Chiudi")
    close_button.connect("clicked", lambda _b: window.destroy())
    actions.pack_start(apply_button, False, False, 0)
    actions.pack_end(close_button, False, False, 0)
    outer.pack_start(actions, False, False, 0)

    def selected_variant() -> str:
        for variant_id, button in buttons.items():
            if button.get_active():
                return variant_id
        return str(state["variant"])

    selecting = {"busy": False}

    def set_selected(variant: str) -> None:
        if selecting["busy"]:
            return
        selecting["busy"] = True
        try:
            for vid, item in buttons.items():
                desired = vid == variant
                if item.get_active() != desired:
                    item.set_active(desired)
        finally:
            selecting["busy"] = False

    def update_sensitivity() -> None:
        follow = follow_switch.get_active()
        for button in buttons.values():
            button.set_sensitive(not follow)
            button.set_opacity(0.55 if follow else 1.0)
        if follow:
            set_selected(desktop_theme())
            status.set_text(
                f"Il login segue il desktop: tema {desktop_theme()}."
            )
        else:
            status.set_text(f"Tema login scelto: {selected_variant()}.")

    follow_switch.connect("notify::active", lambda *_: update_sensitivity())
    for variant_id, button in buttons.items():
        button.connect("clicked", lambda _b, vid=variant_id: set_selected(vid))
        button.connect(
            "toggled",
            lambda b, vid=variant_id: status.set_text(f"Tema scelto: {vid}")
            if b.get_active()
            else None,
        )
    set_selected(str(state["variant"]))
    update_sensitivity()

    busy = {"value": False}

    def do_apply(_button=None) -> None:
        if busy["value"]:
            return
        follow = follow_switch.get_active()
        variant = desktop_theme() if follow else selected_variant()
        if follow and variant != desktop_theme():
            status.set_text("Errore: tema desktop non valido.")
            return
        busy["value"] = True
        apply_button.set_sensitive(False)
        status.set_text(f"Applicazione di {variant} (password root)…")

        def finish(ok: bool, message: str) -> None:
            busy["value"] = False
            apply_button.set_sensitive(True)
            if ok:
                try:
                    write_login(follow, variant)
                except (OSError, ValueError) as exc:
                    message = f"Applicato, ma stato non salvato: {exc}"
            status.set_text(message)

        def worker() -> None:
            ok, message = apply_variant(variant)
            GLib.idle_add(finish, ok, message)

        import threading

        threading.Thread(target=worker, daemon=True).start()

    apply_button.connect("clicked", do_apply)

    window.connect("destroy", lambda *_a: Gtk.main_quit())
    window.show_all()
    Gtk.main()
    return 0


def draw_preview(widget, cr, variant: str) -> bool:
    colors = theme_colors(variant)
    width = widget.get_allocated_width()
    height = widget.get_allocated_height()

    def rgb(key: str) -> tuple[float, float, float]:
        value = colors[key].lstrip("#")
        return tuple(int(value[i : i + 2], 16) / 255 for i in (0, 2, 4))

    cr.set_source_rgb(*rgb("BG"))
    cr.rectangle(0, 0, width, height)
    cr.fill()

    accent = rgb("ACCENT")
    accent_soft = rgb("ACCENT_SOFT")
    surface = rgb("SURFACE")
    text = rgb("FG")

    if variant == "nordic-cobalt":
        # Card centrale con alone.
        cr.set_source_rgba(*accent, 0.18)
        cr.arc(width / 2, height / 2, height * 0.55, 0, 6.283)
        cr.fill()
        card_w, card_h = width * 0.44, height * 0.66
        cr.set_source_rgba(*surface, 0.95)
        cr.rectangle((width - card_w) / 2, (height - card_h) / 2, card_w, card_h)
        cr.fill()
        cr.set_source_rgb(*accent)
        cr.rectangle((width - card_w) / 2, (height - card_h) / 2, card_w, 3)
        cr.fill()
        cr.set_source_rgb(*text)
        cr.rectangle(width / 2 - card_w * 0.3, height / 2 - 6, card_w * 0.6, 4)
        cr.fill()
        cr.rectangle(width / 2 - card_w * 0.3, height / 2 + 6, card_w * 0.6, 4)
        cr.fill()
    elif variant == "muted-crimson":
        # Pannello laterale sinistro.
        cr.set_source_rgba(*surface, 0.95)
        cr.rectangle(0, 0, width * 0.34, height)
        cr.fill()
        cr.set_source_rgb(*accent)
        cr.rectangle(width * 0.34 - 3, 0, 3, height)
        cr.fill()
        cr.set_source_rgb(*text)
        cr.rectangle(width * 0.06, height * 0.62, width * 0.2, 6)
        cr.fill()
        cr.set_source_rgba(*text, 0.5)
        cr.rectangle(width * 0.06, height * 0.72, width * 0.14, 3)
        cr.fill()
        cr.set_source_rgb(*accent_soft)
        cr.rectangle(width * 0.56, height * 0.32, width * 0.3, 8)
        cr.fill()
        cr.set_source_rgba(*text, 0.6)
        cr.rectangle(width * 0.56, height * 0.46, width * 0.3, 5)
        cr.fill()
        cr.rectangle(width * 0.56, height * 0.56, width * 0.3, 5)
        cr.fill()
        cr.set_source_rgb(*accent)
        cr.rectangle(width * 0.56, height * 0.68, width * 0.16, 10)
        cr.fill()
    else:
        # Barra inferiore.
        cr.set_source_rgba(*accent, 0.14)
        cr.arc(width * 0.5, height * 0.95, width * 0.45, 0, 6.283)
        cr.fill()
        bar_w, bar_h = width * 0.78, height * 0.3
        cr.set_source_rgba(*surface, 0.96)
        cr.rectangle((width - bar_w) / 2, height - bar_h - 8, bar_w, bar_h)
        cr.fill()
        cr.set_source_rgb(*accent)
        cr.rectangle((width - bar_w) / 2, height - bar_h - 8, 60, 3)
        cr.fill()
        cr.set_source_rgba(*text, 0.75)
        cr.rectangle(width * 0.18, height - bar_h, width * 0.2, 5)
        cr.fill()
        cr.rectangle(width * 0.4, height - bar_h, width * 0.2, 5)
        cr.fill()
        cr.set_source_rgb(*accent)
        cr.rectangle(width * 0.64, height - bar_h, width * 0.1, 12)
        cr.fill()
    return False


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if args:
        return cli(args)
    return gui()


if __name__ == "__main__":
    raise SystemExit(main())
