#!/usr/bin/env bash
# =============================================================================
#  labwc-desktop-menu - selettore desktop 1-4 (Fuzzel / Zenity)
# =============================================================================
set -uo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/labwc-q4os"
current="$(cat "$STATE/desktop" 2>/dev/null || echo 1)"
entries=()
for n in 1 2 3 4; do
    marker="  "
    [ "$n" = "$current" ] && marker="● "
    entries+=("${marker}Desktop $n")
done

choice=""
if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v fuzzel >/dev/null 2>&1; then
    choice="$(printf '%s\n' "${entries[@]}" | fuzzel --dmenu --prompt="Desktop > " --width=30 --lines=5)" || exit 0
elif [ -n "${DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; then
    choice="$(zenity --list --title="Labwc — Desktop" --text="Scegli il desktop" \
        --column="Desktop" --width=340 --height=260 "${entries[@]}")" || exit 0
fi

case "$choice" in
    *"Desktop 1"*) exec "$HOME/.local/bin/labwc-desktop" 1 ;;
    *"Desktop 2"*) exec "$HOME/.local/bin/labwc-desktop" 2 ;;
    *"Desktop 3"*) exec "$HOME/.local/bin/labwc-desktop" 3 ;;
    *"Desktop 4"*) exec "$HOME/.local/bin/labwc-desktop" 4 ;;
esac
