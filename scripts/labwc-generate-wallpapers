#!/usr/bin/env bash
# =============================================================================
#  labwc-generate-wallpapers - rigenera i tre sfondi e riapplica il tema
# =============================================================================
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

SHARE="${LABWC_Q4OS_SHARE:-${XDG_DATA_HOME:-$HOME/.local/share}/labwc-q4os}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
GENERATOR="$SHARE/scripts/generate-wallpapers.py"

if [ ! -r "$GENERATOR" ]; then
    printf 'Generatore non trovato: %s\n' "$GENERATOR" >&2
    exit 1
fi

python3 "$GENERATOR" --output "$SHARE/wallpapers" --width 2560 --height 1440

theme="nordic-cobalt"
[ -r "$CONFIG/labwc/theme" ] && theme="$(tr -d '[:space:]' < "$CONFIG/labwc/theme")"

APPLY="$HOME/.local/bin/labwc-theme-apply"
[ -x "$APPLY" ] || APPLY="$SHARE/scripts/labwc-theme-apply"
[ -x "$APPLY" ] || { printf 'labwc-theme-apply non trovato\n' >&2; exit 1; }

"$APPLY" "$theme" --quiet
printf 'Sfondi rigenerati in %s\n' "$SHARE/wallpapers"
