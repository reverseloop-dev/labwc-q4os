#!/usr/bin/env bash
# =============================================================================
#  bluetooth-state - applica lo stato Bluetooth scelto dall'utente.
#
#  La scelta vive in /var/lib/labwc-q4os/bluetooth ("on" / "off") e viene
#  riapplicata in tre momenti: dalla regola udev quando l'adattatore compare,
#  dal servizio di boot labwc-q4os-bluetooth.service (dopo systemd-rfkill e
#  bluetooth.service), e da labwc-bluetooth quando l'utente cambia scelta.
#
#  Uso:
#    bluetooth-state apply       applica lo stato salvato (root o udev)
#    bluetooth-state wait        come apply, ritenta 10 s (servizio di boot)
#    bluetooth-state show        stampa "on" / "off" (vuoto se mai scelto)
#    bluetooth-state set on|off  salva lo stato e lo applica (root)
#
#  Variabili per i test: LABWC_BLUETOOTH_STATE (file), LABWC_BLUETOOTH_RFKILL
#  (comando rfkill da usare).
# =============================================================================
set -euo pipefail

STATE_FILE="${LABWC_BLUETOOTH_STATE:-/var/lib/labwc-q4os/bluetooth}"
if [ -n "${LABWC_BLUETOOTH_RFKILL:-}" ]; then
    RFKILL="$LABWC_BLUETOOTH_RFKILL"
else
    RFKILL="$(command -v rfkill 2>/dev/null || true)"
    [ -n "$RFKILL" ] || RFKILL="/usr/sbin/rfkill"
fi

read_state() {
    [ -r "$STATE_FILE" ] || return 0
    tr -d '[:space:]' < "$STATE_FILE"
}

apply_state() {
    local state tries="${1:-1}" i=1
    state="$(read_state)"
    [ -n "$state" ] || return 0
    command -v "$RFKILL" >/dev/null 2>&1 || [ -x "$RFKILL" ] || return 0
    while :; do
        case "$state" in
            off) "$RFKILL" block bluetooth >/dev/null 2>&1 || true ;;
            on) "$RFKILL" unblock bluetooth >/dev/null 2>&1 || true ;;
        esac
        [ "$i" -ge "$tries" ] && break
        # Senza adattatore ancora presente non c'e' nulla da verificare:
        # riprova al giro successivo.
        if ! "$RFKILL" list bluetooth 2>/dev/null | grep -q .; then
            sleep 1
            i=$((i + 1))
            continue
        fi
        if [ "$state" = off ]; then
            "$RFKILL" list bluetooth 2>/dev/null | grep -q "Soft blocked: yes" && break
        else
            "$RFKILL" list bluetooth 2>/dev/null | grep -q "Soft blocked: yes" || break
        fi
        sleep 1
        i=$((i + 1))
    done
}

case "${1:-apply}" in
    apply)
        apply_state 1
        ;;
    wait)
        # Usato dal servizio di boot: attende che l'adattatore compaia.
        apply_state 10
        ;;
    show)
        read_state
        ;;
    set)
        state="${2:-}"
        case "$state" in
            on | off) ;;
            *)
                printf 'Uso: %s set on|off\n' "$0" >&2
                exit 2
                ;;
        esac
        install -d -m 0755 "$(dirname "$STATE_FILE")"
        printf '%s\n' "$state" >"$STATE_FILE"
        apply_state
        ;;
    -h | --help)
        sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        printf 'Uso: %s [apply|show|set on|off]\n' "$0" >&2
        exit 2
        ;;
esac
