#!/usr/bin/env bash
# =============================================================================
#  labwc-youtube - YouTube leggero con GUI (zenity) + mpv/yt-dlp
#
#  Incolla un URL oppure cerca: la scelta avviene in una finestra, il video
#  si apre in mpv (720p, H.264 quando disponibile). Nessun browser.
# =============================================================================
set -u

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "YouTube leggero" "$1" "${2:-}" >/dev/null 2>&1 || true
    else
        printf 'YouTube leggero: %s %s\n' "$1" "${2:-}" >&2
    fi
}

if [ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
    notify "Sessione grafica non rilevata" "Avvia YouTube leggero dal desktop."
    exit 1
fi
for cmd in zenity mpv yt-dlp; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        notify "Componente mancante: $cmd" "Esegui l'installer e scegli YouTube leggero."
        exit 1
    fi
done

query="$(
    zenity --entry \
        --title="YouTube leggero" \
        --text="Incolla un URL YouTube oppure scrivi una ricerca:" \
        --entry-text="" --width=600 2>/dev/null
)" || exit 0
[ -n "$query" ] || exit 0

url=""
case "$query" in
    http://*|https://*|www.*) url="$query" ;;
esac

if [ -z "$url" ]; then
    results="$(
        yt-dlp --flat-playlist --no-warnings \
            --print "%(title)s"$'\t'"%(webpage_url)s" \
            "ytsearch10:${query}" 2>/dev/null || true
    )"
    if [ -z "$results" ]; then
        notify "Nessun risultato" "Controlla la connessione o cambia ricerca."
        exit 1
    fi
    rows=()
    urls=()
    index=0
    while IFS=$'\t' read -r title page_url; do
        [ -n "$page_url" ] || continue
        index=$((index + 1))
        rows+=("$index"$'\t'"${title:-Video}")
        urls+=("$page_url")
    done <<< "$results"
    [ "${#rows[@]}" -gt 0 ] || exit 1
    choice="$(
        printf '%s\n' "${rows[@]}" |
            zenity --list --title="YouTube leggero" \
                --text="Scegli il video da riprodurre." \
                --column="#" --column="Titolo" \
                --print-column=1 --width=760 --height=440 2>/dev/null
    )" || exit 0
    choice="${choice%%$'\t'*}"
    case "$choice" in
        *[!0-9]*) exit 0 ;;
    esac
    index=$((choice - 1))
    [ "$index" -ge 0 ] && [ "$index" -lt "${#urls[@]}" ] || exit 0
    url="${urls[$index]}"
fi

# H.264 a 720p quando c'e': decodifica hardware anche su GPU vecchie.
mpv --no-terminal --force-window=yes --hwdec=auto-safe \
    --ytdl-format='bestvideo[height<=720][vcodec^=avc1]+bestaudio/best[height<=720]/best' \
    --title="YouTube leggero" "$url" >/dev/null 2>&1 &
