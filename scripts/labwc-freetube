#!/usr/bin/env bash
# =============================================================================
#  labwc-freetube - FreeTube con scelta Cage / Labwc / Annulla
# =============================================================================
set -u
FREETUBE="io.freetubeapp.FreeTube"

if ! command -v flatpak >/dev/null 2>&1 ||
    ! flatpak info "$FREETUBE" >/dev/null 2>&1; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "FreeTube" "FreeTube non installato" \
            "Esegui l'installer e scegli FreeTube." >/dev/null 2>&1 || true
    fi
    exit 1
fi

exec "$HOME/.local/bin/labwc-cage" --ask -- flatpak run "$FREETUBE"
