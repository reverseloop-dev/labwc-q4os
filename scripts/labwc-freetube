#!/usr/bin/env bash
# =============================================================================
#  labwc-freetube - FreeTube normale nella sessione Labwc.
#
#  La voce "FreeTube (cage)" usa labwc-freetube-cage: chiude labwc, avvia
#  FreeTube in Cage e aggiunge il pulsante X.
# =============================================================================
set -u
if command -v freetube >/dev/null 2>&1; then
    exec freetube --ozone-platform=wayland
fi
if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "FreeTube" "FreeTube non installato" \
        "Esegui l'installer e scegli FreeTube." >/dev/null 2>&1 || true
fi
exit 1
