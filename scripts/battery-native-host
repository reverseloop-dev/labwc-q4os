#!/usr/bin/env python3
"""battery-native-host - native messaging host per l'addon labwc-q4os.

Legge /sys/class/power_supply e risponde a {"type":"battery"} con percentuale,
stato di carica e stima dei minuti rimanenti (o al pieno). Protocollo native
messaging: 4 byte little-endian di lunghezza + JSON, su stdin/stdout.
"""

from __future__ import annotations

import json
import os
import struct
import sys

SUPPLY = os.environ.get("LABWC_POWER_SUPPLY", "/sys/class/power_supply")


def read_int(base: str, name: str) -> int | None:
    try:
        with open(os.path.join(base, name), encoding="utf-8") as handle:
            return int(handle.read().strip())
    except (OSError, ValueError):
        return None


def read_text(base: str, name: str) -> str:
    try:
        with open(os.path.join(base, name), encoding="utf-8") as handle:
            return handle.read().strip()
    except OSError:
        return ""


def battery() -> dict[str, object]:
    try:
        entries = sorted(os.listdir(SUPPLY))
    except OSError:
        entries = []
    for name in entries:
        if not name.startswith("BAT"):
            continue
        base = os.path.join(SUPPLY, name)
        pct = read_int(base, "capacity")
        status = read_text(base, "status")
        charging = status in ("Charging", "Full")
        power = read_int(base, "power_now")
        energy_now = read_int(base, "energy_now")
        energy_full = read_int(base, "energy_full")
        if energy_now is None or energy_full is None:
            charge_now = read_int(base, "charge_now")
            charge_full = read_int(base, "charge_full")
            voltage = read_int(base, "voltage_now")
            if charge_now is not None and charge_full is not None and voltage:
                # µAh * µV = pWh -> µWh
                energy_now = charge_now * voltage // 1_000_000
                energy_full = charge_full * voltage // 1_000_000
        if power is None:
            current = read_int(base, "current_now")
            voltage = read_int(base, "voltage_now")
            if current is not None and voltage:
                # µA * µV = pW -> µW
                power = abs(current) * voltage // 1_000_000
        if power is not None:
            power = abs(power)
        minutes_left = None
        minutes_to_full = None
        if power and power > 0:
            if not charging and energy_now is not None:
                minutes_left = int(round(energy_now / power * 60))
            if charging and energy_now is not None and energy_full is not None:
                minutes_to_full = int(round(max(0, energy_full - energy_now) / power * 60))
        return {
            "ok": True,
            "pct": pct if pct is not None else -1,
            "status": status,
            "charging": charging,
            "minutesLeft": minutes_left,
            "minutesToFull": minutes_to_full,
            "energyNow": energy_now,
            "energyFull": energy_full,
            "powerNow": power,
        }
    return {"ok": True, "pct": -1, "status": "No battery", "charging": False,
            "minutesLeft": None, "minutesToFull": None, "source": "rete"}


def send(payload: dict[str, object]) -> None:
    raw = json.dumps(payload).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("<I", len(raw)))
    sys.stdout.buffer.write(raw)
    sys.stdout.buffer.flush()


def main() -> int:
    while True:
        header = sys.stdin.buffer.read(4)
        if len(header) != 4:
            return 0
        (length,) = struct.unpack("<I", header)
        if length <= 0 or length > 1024 * 1024:
            return 0
        body = sys.stdin.buffer.read(length)
        try:
            message = json.loads(body.decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            message = {}
        if isinstance(message, dict) and message.get("type") == "ping":
            send({"ok": True, "pong": True})
            continue
        send(battery())


if __name__ == "__main__":
    raise SystemExit(main())
