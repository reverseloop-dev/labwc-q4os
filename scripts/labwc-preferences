#!/usr/bin/env python3
"""
labwc-preferences - preferenze grafiche della scrivania Labwc.

Un'unica finestra per:
  * cambiare tema (blu, rosso tenue, verde salvia);
  * impostare la tastiera (it, us, it,us) e il layout di login;
  * selezionare i desktop 1-4;
  * aprire ZRAM, aggiornamenti, app nel menu, diagnostica e aiuto.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
import threading
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
SHARE = Path(
    os.environ.get(
        "LABWC_Q4OS_SHARE",
        Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "labwc-q4os",
    )
)
BIN = HOME / ".local/bin"
ENV_FILE = CONFIG / "labwc/environment"
LOGIN_CONF = CONFIG / "labwc/login.conf"
BATTERY_CONF = CONFIG / "labwc/battery-indicator.conf"
BATTERY_POSITIONS = ("left", "center", "right")
ROOT_LOGIN = Path("/usr/local/libexec/labwc-q4os/login-theme-apply")
VALID_LOGIN = ("nordic-cobalt", "muted-crimson", "sage-emerald")


def colors() -> dict[str, str]:
    theme = "nordic-cobalt"
    try:
        theme = (CONFIG / "labwc/theme").read_text(encoding="utf-8").strip() or theme
    except OSError:
        pass
    result = {
        "BG": "070d1a",
        "SURFACE": "1e293b",
        "SURFACE_ALT": "273449",
        "ACCENT": "3b82f6",
        "ACCENT_SOFT": "60a5fa",
        "FG": "e2e8f0",
        "FG_MUTED": "94a3b8",
        "BORDER": "334155",
    }
    path = SHARE / "themes" / theme / "theme.conf"
    if path.is_file():
        try:
            for raw in path.read_text(encoding="utf-8").splitlines():
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                value = value.strip().strip('"').strip("'").lstrip("#")
                if key in result and value:
                    result[key] = value
        except OSError:
            pass
    return result


def env_value(key: str, default: str = "") -> str:
    try:
        for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
            if line.startswith(key + "="):
                return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return default


def battery_settings() -> tuple[str, bool, bool]:
    position = "left"
    show_percent = True
    show_indicator = True
    try:
        for raw in BATTERY_CONF.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            value = value.strip()
            if key == "position" and value in BATTERY_POSITIONS:
                position = value
            elif key == "show_percent":
                show_percent = value not in ("0", "no", "false")
            elif key == "show_indicator":
                show_indicator = value not in ("0", "no", "false")
    except OSError:
        pass
    return position, show_percent, show_indicator


def write_battery_settings(
    position: str, show_percent: bool, show_indicator: bool
) -> None:
    if position not in BATTERY_POSITIONS:
        position = "left"
    BATTERY_CONF.parent.mkdir(parents=True, exist_ok=True)
    tmp = BATTERY_CONF.with_name(BATTERY_CONF.name + ".tmp")
    tmp.write_text(
        "# gestito da labwc-preferences\n"
        f"position={position}\n"
        f"show_percent={1 if show_percent else 0}\n"
        f"show_indicator={1 if show_indicator else 0}\n",
        encoding="utf-8",
    )
    os.replace(tmp, BATTERY_CONF)


class Preferences:
    def __init__(self) -> None:
        import gi

        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gdk, GLib, Gtk

        self.GLib = GLib
        self.Gtk = Gtk
        self._login_busy = False
        c = colors()

        provider = Gtk.CssProvider()
        provider.load_from_data(self.css(c).encode("utf-8"))
        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        self.window = Gtk.Window(title="Preferenze della scrivania Labwc")
        if screen is not None:
            mon = max(0, screen.get_primary_monitor())
            geo = screen.get_monitor_workarea(mon)
            self.window.set_default_size(
                min(860, max(360, geo.width - 24)),
                min(640, max(320, geo.height - 24)),
            )
        else:
            self.window.set_default_size(860, 640)
        self.window.set_border_width(16)
        self.window.set_position(Gtk.WindowPosition.CENTER)
        self.window.set_icon_name("preferences-desktop")
        self.window.connect("destroy", self.on_destroy)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(outer)
        self.window.add(scroll)

        title = Gtk.Label(label="Preferenze della scrivania Labwc", xalign=0)
        title.get_style_context().add_class("title")
        subtitle = Gtk.Label(
            label="Tema, icone, tastiera, desktop e strumenti di Labwc",
            xalign=0,
        )
        subtitle.get_style_context().add_class("subtitle")
        outer.pack_start(title, False, False, 0)
        outer.pack_start(subtitle, False, False, 0)

        # Tema
        theme_box = self.card("TEMA E COLORI", "Il cambio aggiorna finestre, Waybar, Fuzzel, icone e sfondo.")
        themes = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        for theme_id, label, color in (
            ("nordic-cobalt", "Blu — Nordic Cobalt", c["ACCENT"]),
            ("muted-crimson", "Rosso — Muted Crimson", "c0565b"),
            ("sage-emerald", "Verde — Sage Emerald", "4d9375"),
        ):
            button = Gtk.Button(label=label)
            swatch = Gtk.Image.new_from_icon_name("color-select-symbolic", Gtk.IconSize.BUTTON)
            button.set_image(swatch)
            button.connect("clicked", lambda _b, tid=theme_id: self.apply_theme(tid))
            themes.pack_start(button, True, True, 0)
        theme_box.pack_start(themes, False, False, 0)

        login_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        login_label = Gtk.Label(
            label="Login con gli stessi colori dello sfondo", xalign=0
        )
        self.login_switch = Gtk.Switch()
        self.login_switch.set_active(self.login_follow())
        self.login_switch.connect("notify::active", self.on_login_switch)
        login_button = Gtk.Button(label="Schermata di login…")
        login_button.connect("clicked", lambda _b: self.spawn(BIN / "labwc-login-theme"))
        login_row.pack_start(login_label, True, True, 0)
        login_row.pack_start(login_button, False, False, 0)
        login_row.pack_end(self.login_switch, False, False, 0)
        theme_box.pack_start(login_row, False, False, 0)
        outer.pack_start(theme_box, False, False, 0)

        # Tastiera
        kb_box = self.card("TASTIERA E LOGIN", "Il layout di login viene applicato con localectl.")
        kb_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.keyboard = Gtk.ComboBoxText()
        for value in ("it", "us", "it,us"):
            self.keyboard.append(value, value)
        current = env_value("XKB_DEFAULT_LAYOUT", "it")
        self.keyboard.set_active_id(current if current in ("it", "us", "it,us") else "it")
        kb_row.pack_start(self.keyboard, False, False, 0)
        kb_button = Gtk.Button(label="Applica tastiera")
        kb_button.connect("clicked", self.on_keyboard)
        kb_row.pack_start(kb_button, False, False, 0)
        kb_box.pack_start(kb_row, False, False, 0)
        outer.pack_start(kb_box, False, False, 0)

        # Desktop
        desk_box = self.card("DESKTOP 1–4", "Seleziona il desktop; Waybar mostra l'indicatore 1–4.")
        desk_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        for n in range(1, 5):
            b = Gtk.Button(label=str(n))
            b.connect("clicked", lambda _b, num=n: self.desktop(num))
            desk_row.pack_start(b, True, True, 0)
        desk_box.pack_start(desk_row, False, False, 0)
        outer.pack_start(desk_box, False, False, 0)

        # Indicatore batteria
        battery_pos, battery_percent, battery_indicator = battery_settings()
        bat_box = self.card(
            "INDICATORE BATTERIA",
            "Posizione e visibilità dell'indicatore; il cambio è immediato.",
        )
        bat_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bat_label = Gtk.Label(label="Posizione", xalign=0)
        self.battery_pos = Gtk.ComboBoxText()
        for value, label in (
            ("left", "Sinistra"),
            ("center", "Centro"),
            ("right", "Destra"),
        ):
            self.battery_pos.append(value, label)
        self.battery_pos.set_active_id(battery_pos)
        self.battery_pos.connect("changed", self.on_battery_pos)
        bat_row.pack_start(bat_label, False, False, 0)
        bat_row.pack_start(self.battery_pos, False, False, 0)

        self.battery_percent = Gtk.Switch()
        self.battery_percent.set_active(battery_percent)
        self.battery_percent.set_tooltip_text("Mostra la percentuale accanto all'icona")
        self.battery_percent.connect(
            "notify::active", self.on_battery_percent
        )
        percent_label = Gtk.Label(label="Percentuale", xalign=0)
        bat_row.pack_end(self.battery_percent, False, False, 0)
        bat_row.pack_end(percent_label, False, False, 6)

        self.battery_indicator = Gtk.Switch()
        self.battery_indicator.set_active(battery_indicator)
        self.battery_indicator.set_tooltip_text(
            "Mostra o nasconde l'indicatore completo (icona e percentuale)"
        )
        self.battery_indicator.connect(
            "notify::active", self.on_battery_indicator
        )
        indicator_label = Gtk.Label(label="Icona", xalign=0)
        bat_row.pack_end(self.battery_indicator, False, False, 0)
        bat_row.pack_end(indicator_label, False, False, 6)
        bat_row.pack_end(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 6)

        bat_box.pack_start(bat_row, False, False, 0)
        outer.pack_start(bat_box, False, False, 0)

        # Strumenti
        tools = self.card("STRUMENTI", "Funzioni della scrivania e della sessione.")
        tool_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        for label, command in (
            ("ZRAM", BIN / "labwc-zram"),
            ("Aggiornamenti", BIN / "labwc-update-gui"),
            ("App nel menu", BIN / "labwc-app-manager"),
            ("App in Fuzzel", BIN / "labwc-fuzzel-apps"),
            ("Aiuto", BIN / "labwc-help"),
        ):
            b = Gtk.Button(label=label)
            b.connect("clicked", lambda _b, cmd=command: self.spawn(cmd))
            tool_row.pack_start(b, True, True, 0)
        tools.pack_start(tool_row, False, False, 0)
        outer.pack_start(tools, False, False, 0)

        self.status = Gtk.Label(label="", xalign=0)
        self.status.get_style_context().add_class("status")
        outer.pack_start(self.status, False, False, 0)

        close = Gtk.Button(label="Chiudi")
        close.set_halign(Gtk.Align.END)
        close.connect("clicked", lambda _b: self.window.destroy())
        outer.pack_end(close, False, False, 0)

        signature = Gtk.Label(label="reverseloop-dev", xalign=1)
        signature.set_halign(Gtk.Align.END)
        signature.set_opacity(0.45)
        signature.get_style_context().add_class("subtitle")
        outer.pack_end(signature, False, False, 0)

        self.window.show_all()

    def css(self, c: dict[str, str]) -> str:
        return f"""
        window {{ background-color: #{c['BG']}; color: #{c['FG']}; }}
        .title {{ font-size: 26px; font-weight: 700; }}
        .subtitle {{ color: #{c['FG_MUTED']}; font-size: 12px; }}
        .card {{ background-color: #{c['SURFACE']}; border: 1px solid #{c['BORDER']};
                 border-radius: 14px; padding: 14px; }}
        .card-title {{ color: #{c['ACCENT_SOFT']}; font-size: 11px;
                       font-weight: 700; letter-spacing: 1px; }}
        .card-hint {{ color: #{c['FG_MUTED']}; font-size: 11px; }}
        .status {{ color: #{c['ACCENT_SOFT']}; font-size: 12px; font-weight: 600; }}
        button {{ background-image: none; background-color: #{c['SURFACE_ALT']};
                  color: #{c['FG']}; border: 1px solid #{c['BORDER']};
                  border-radius: 9px; padding: 8px 14px; font-weight: 600; }}
        button label {{ color: #{c['FG']}; }}
        button:hover {{ background-image: none; border-color: #{c['ACCENT']}; }}
        checkbutton {{ color: #{c['FG']}; }}
        checkbutton check {{ background-image: none; background-color: #{c['SURFACE_ALT']};
                             border: 1px solid #{c['BORDER']}; }}
        checkbutton check:checked {{ background-image: none; background-color: #{c['ACCENT']}; }}
        combobox, combobox button {{ background-image: none; color: #{c['FG']}; }}
        """

    def card(self, title: str, hint: str):
        Gtk = self.Gtk
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.get_style_context().add_class("card")
        t = Gtk.Label(label=title, xalign=0)
        t.get_style_context().add_class("card-title")
        h = Gtk.Label(label=hint, xalign=0)
        h.set_line_wrap(True)
        h.get_style_context().add_class("card-hint")
        box.pack_start(t, False, False, 0)
        box.pack_start(h, False, False, 0)
        return box

    def login_state(self) -> tuple[bool, str]:
        follow, variant = True, "nordic-cobalt"
        try:
            for line in LOGIN_CONF.read_text(encoding="utf-8").splitlines():
                if line.startswith("follow_theme="):
                    follow = line.split("=", 1)[1].strip() != "0"
                elif line.startswith("variant="):
                    value = line.split("=", 1)[1].strip()
                    if value in VALID_LOGIN:
                        variant = value
        except OSError:
            pass
        return follow, variant

    def login_follow(self) -> bool:
        return self.login_state()[0]

    def current_theme(self) -> str:
        try:
            value = (CONFIG / "labwc/theme").read_text(encoding="utf-8").strip()
        except OSError:
            value = ""
        return value if value in VALID_LOGIN else "nordic-cobalt"

    def write_login(self, follow: bool, variant: str) -> None:
        LOGIN_CONF.parent.mkdir(parents=True, exist_ok=True)
        extra = ""
        try:
            for raw in LOGIN_CONF.read_text(encoding="utf-8").splitlines():
                if not raw.strip().startswith(("follow_theme=", "variant=")):
                    extra += raw + "\n"
        except OSError:
            pass
        LOGIN_CONF.write_text(
            f"{extra}follow_theme={1 if follow else 0}\nvariant={variant}\n",
            encoding="utf-8",
        )

    def apply_login(self, variant: str) -> tuple[bool, str]:
        if not ROOT_LOGIN.is_file():
            return False, "Helper login mancante: esegui install.sh."
        command = [str(ROOT_LOGIN), variant]
        if os.geteuid() != 0:
            if not shutil.which("pkexec"):
                return False, "pkexec non disponibile: impossibile chiedere la password."
            command = ["pkexec", str(ROOT_LOGIN), variant]
        result = subprocess.run(command, capture_output=True, text=True, check=False)
        detail = (result.stdout or result.stderr or "").strip().splitlines()
        message = detail[-1] if detail else ""
        if result.returncode == 0:
            return True, message or f"Tema login applicato: {variant}"
        if result.returncode in (126, 127):
            return False, "Autorizzazione annullata."
        return False, message or f"Errore login (codice {result.returncode})."

    def on_login_switch(self, switch, _param) -> None:
        if self._login_busy:
            self._login_busy = True
            switch.set_active(not switch.get_active())
            self._login_busy = False
            self.status.set_text("Attendi: aggiornamento del login già in corso.")
            return
        follow = switch.get_active()
        _, variant = self.login_state()
        if follow:
            variant = self.current_theme()
        try:
            self.write_login(follow, variant)
        except OSError as exc:
            self.status.set_text(f"Errore login: {exc}")
            return
        if not follow:
            self.status.set_text(
                "Il login non segue più lo sfondo: scegli il tema da Schermata di login."
            )
            return
        self.status.set_text("Aggiornamento della schermata di login…")
        self._login_busy = True

        def worker() -> None:
            ok, message = self.apply_login(variant)
            self.GLib.idle_add(self.login_done, ok, message)

        threading.Thread(target=worker, daemon=True).start()

    def login_done(self, ok: bool, message: str) -> bool:
        self.status.set_text(message)
        if not ok and self.login_switch.get_active():
            self._login_busy = True
            self.login_switch.set_active(False)
            try:
                self.write_login(False, self.current_theme())
            except OSError:
                pass
            self._login_busy = False
        self._login_busy = False
        return False

    def apply_theme(self, theme_id: str) -> None:
        apply = BIN / "labwc-theme-apply"
        if not apply.is_file():
            self.status.set_text("labwc-theme-apply non trovato.")
            return
        self.status.set_text(f"Applicazione tema {theme_id}…")

        def worker() -> None:
            try:
                result = subprocess.run(
                    [str(apply), theme_id],
                    capture_output=True,
                    text=True,
                    timeout=180,
                    check=False,
                )
                ok = result.returncode == 0
            except (OSError, subprocess.SubprocessError):
                ok = False
            self.GLib.idle_add(self.theme_done, theme_id, ok)

        threading.Thread(target=worker, daemon=True).start()

    def theme_done(self, theme_id: str, ok: bool) -> bool:
        if ok:
            self.status.set_text(f"Tema applicato: {theme_id}")
        else:
            self.status.set_text(
                f"Tema {theme_id}: applicazione parziale o annullata (controlla i permessi)."
            )
        return False

    def on_keyboard(self) -> None:
        value = self.keyboard.get_active_id() or "it"
        try:
            lines = []
            if ENV_FILE.exists():
                lines = [
                    line for line in ENV_FILE.read_text(encoding="utf-8").splitlines()
                    if not line.startswith("XKB_DEFAULT_LAYOUT=")
                    and not line.startswith("XKB_DEFAULT_OPTIONS=")
                ]
            lines.append(f"XKB_DEFAULT_LAYOUT={value}")
            if "," in value:
                lines.append("XKB_DEFAULT_OPTIONS=grp:alt_shift_toggle")
            ENV_FILE.parent.mkdir(parents=True, exist_ok=True)
            ENV_FILE.write_text("\n".join(lines) + "\n", encoding="utf-8")
        except OSError as exc:
            self.status.set_text(f"Errore tastiera: {exc}")
            return

        primary = value.split(",", 1)[0]
        self.status.set_text("Layout labwc aggiornato. Applico il login…")

        def worker() -> None:
            if shutil.which("pkexec") and shutil.which("localectl"):
                subprocess.run(
                    ["pkexec", "localectl", "set-keyboard-layout", primary],
                    capture_output=True,
                    text=True,
                    timeout=60,
                    check=False,
                )
            self.GLib_idle()

        threading.Thread(target=worker, daemon=True).start()

    def GLib_idle(self) -> None:
        from gi.repository import GLib

        GLib.idle_add(
            lambda: self.status.set_text(
                "Tastiera impostata. Riavvia la sessione per applicarla a labwc."
            )
            and False
        )

    def desktop(self, number: int) -> None:
        script = BIN / "labwc-desktop"
        if script.is_file():
            subprocess.Popen([str(script), str(number)], start_new_session=True)
            self.status.set_text(f"Desktop {number} selezionato.")
        else:
            self.status.set_text("labwc-desktop non trovato.")

    def on_battery_pos(self, _widget=None) -> None:
        self.save_battery()

    def on_battery_percent(self, _switch, _param) -> None:
        self.save_battery()

    def on_battery_indicator(self, _switch, _param) -> None:
        self.save_battery()

    def save_battery(self) -> None:
        position = self.battery_pos.get_active_id() or "left"
        show_percent = self.battery_percent.get_active()
        show_indicator = self.battery_indicator.get_active()
        try:
            write_battery_settings(position, show_percent, show_indicator)
        except OSError as exc:
            self.status.set_text(f"Errore indicatore batteria: {exc}")
            return
        self.status.set_text("Indicatore batteria aggiornato.")

    def spawn(self, command: Path) -> None:
        if not command.is_file():
            self.status.set_text(f"Comando non trovato: {command.name}")
            return
        subprocess.Popen([str(command)], start_new_session=True)
        self.status.set_text(f"Aperto: {command.name}")

    def on_destroy(self, *_args) -> None:
        # Menu e categorie possono essere stati modificati dalle app aperte
        # da questa finestra: labwc deve rileggere menu.xml alla chiusura.
        if os.environ.get("WAYLAND_DISPLAY") and shutil.which("labwc"):
            try:
                subprocess.run(
                    ["labwc", "--reconfigure"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=15,
                    check=False,
                )
            except (OSError, subprocess.SubprocessError):
                pass
        self.Gtk.main_quit()

    def run(self) -> int:
        self.Gtk.main()
        return 0


def main() -> int:
    try:
        import gi

        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gtk
    except (ImportError, ValueError) as exc:
        print(f"GTK3/PyGObject non disponibile: {exc}", file=sys.stderr)
        return 1
    Gtk.init([])
    return Preferences().run()


if __name__ == "__main__":
    raise SystemExit(main())
