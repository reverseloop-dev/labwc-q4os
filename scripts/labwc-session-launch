#!/usr/bin/env bash
# =============================================================================
#  labwc-session-launch - avvia labwc-q4os in modo affidabile
#
#  Usato dal file di sessione /usr/share/wayland-sessions/labwc.desktop.
#  Serve quando il login e' gestito da SDDM/Plasma: garantisce HOME e XDG
#  corretti, ripara la configurazione se manca e scrive un log di avvio.
#  Senza questo wrapper, con un login Plasma/SDDM "estraneo", labwc puo'
#  partire con la configurazione sbagliata (schermo nero, menu minimo).
#
#  Uso: labwc-session-launch [--check]
# =============================================================================
set -uo pipefail

user_name="$(id -un)"
user_home="$(getent passwd "$user_name" | cut -d: -f6)"
[ -n "$user_home" ] && [ -d "$user_home" ] || user_home="$HOME"

export HOME="$user_home"
export USER="$user_name"
export LOGNAME="$user_name"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=labwc
export XDG_SESSION_DESKTOP=labwc

STATE="$XDG_STATE_HOME/labwc-q4os"
LOG="$STATE/session.log"
mkdir -p "$STATE" 2>/dev/null || true
printf '\n===== labwc-session-launch %s (HOME=%s) =====\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" "$HOME" >>"$LOG" 2>&1

# Helper per chiudere in modo chirurgico Cage e le app rimaste quando
# l'utente esce dalla console (file cage-exit.request scritto da
# labwc-cage-help), senza usare pkill -x cage alla cieca.
cage_pid_alive() {
    local target="${1:-}" status
    [ -n "$target" ] || return 1
    status="$(ps -o stat= -p "$target" 2>/dev/null)" || return 1
    [ -n "$status" ] || return 1
    case "$status" in
        Z*) return 1 ;;
    esac
    return 0
}

cage_descendants() {
    local parent="$1" child
    for child in $(ps -o pid= --ppid "$parent" 2>/dev/null); do
        cage_descendants "$child"
        printf '%s\n' "$child"
    done
}

cage_kill_tree() {
    local target="${1:-}" children child _
    [ -n "$target" ] || return 0
    children="$(cage_descendants "$target")"
    for child in $children; do
        kill -TERM "$child" 2>/dev/null || true
    done
    kill -TERM "$target" 2>/dev/null || true
    for _ in $(seq 1 12); do
        cage_pid_alive "$target" || break
        sleep 0.1
    done
    for child in $children; do
        kill -KILL "$child" 2>/dev/null || true
    done
    kill -KILL "$target" 2>/dev/null || true
}

# Configurazione minima: se manca, ripara prima di avviare il compositor.
config_ok=1
for file in rc.xml menu.xml autostart; do
    [ -r "$XDG_CONFIG_HOME/labwc/$file" ] || config_ok=0
done
[ -x "$XDG_CONFIG_HOME/labwc/autostart" ] || config_ok=0

if [ "$config_ok" -eq 0 ]; then
    printf 'configurazione labwc incompleta: eseguo labwc-doctor --fix\n' >>"$LOG"
    doctor="$HOME/.local/bin/labwc-doctor"
    if [ -x "$doctor" ]; then
        timeout 60 "$doctor" --fix >>"$LOG" 2>&1 ||
            printf 'labwc-doctor --fix non riuscito\n' >>"$LOG"
    else
        printf 'labwc-doctor mancante: sessione non configurata\n' >>"$LOG"
    fi
fi

if [ "${1:-}" = "--check" ]; then
    if [ "$config_ok" -eq 1 ]; then
        printf 'sessione pronta: %s\n' "$HOME"
        exit 0
    fi
    printf 'sessione incompleta: %s\n' "$HOME"
    exit 1
fi

if ! command -v labwc >/dev/null 2>&1; then
    printf 'labwc non trovato nel PATH\n' >>"$LOG"
    exit 1
fi

# Porta nell'ambiente systemd utente le variabili Wayland, se possibile.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE \
        XDG_SESSION_DESKTOP XDG_RUNTIME_DIR >/dev/null 2>&1 || true
fi

printf 'exec labwc\n' >>"$LOG"

# Rete di sicurezza: labwc esegue ~/.config/labwc/autostart, ma con login
# Plasma/SDDM o configurazioni migrate puo' non farlo. Dopo l'avvio del
# compositor controlliamo che la shell scelta sia attiva; se manca, avviamo
# labwc-session-start una volta. Cosi' sfondo e barra compaiono da soli.
(
    attempt=0
    while [ "$attempt" -lt 60 ]; do
        if find "$XDG_RUNTIME_DIR" -maxdepth 1 -name 'wayland-*' -type s \
            -print -quit 2>/dev/null | grep -q .; then
            break
        fi
        attempt=$((attempt + 1))
        sleep 0.25
    done
    sleep 2.5
    shell_mode=""
    [ -r "$XDG_CONFIG_HOME/labwc/shell" ] &&
        shell_mode="$(tr -d '[:space:]' < "$XDG_CONFIG_HOME/labwc/shell")"
    case "$shell_mode" in
        waybar|noctalia) ;;
        *) shell_mode="" ;;
    esac
    if [ -z "$shell_mode" ] && [ -r /etc/labwc-q4os/install-options ]; then
        shell_mode="$(sed -n 's/^SHELL=//p' /etc/labwc-q4os/install-options |
            head -n1 | tr -d '[:space:]')"
    fi
    if [ "$shell_mode" = "noctalia" ] && command -v noctalia >/dev/null 2>&1; then
        expected="noctalia"
    else
        expected="waybar"
    fi
    # Il socket Wayland e' creato da labwc solo dopo l'avvio: senza questa
    # variabile Waybar/swaybg fallirebbero al primo tentativo (schermo nero
    # finche' non si ricarica il desktop a mano).
    watch_socket="$(find "$XDG_RUNTIME_DIR" -maxdepth 1 \
        -name 'wayland-*' -type s -print -quit 2>/dev/null || true)"
    if [ -n "$watch_socket" ]; then
        WAYLAND_DISPLAY="$(basename "$watch_socket")"
        export WAYLAND_DISPLAY
    fi
    if ! pgrep -x "$expected" >/dev/null 2>&1 &&
        ! pgrep -f 'labwc-session-start' >/dev/null 2>&1; then
        printf 'shell %s non attiva dopo il login: avvio labwc-session-start\n' \
            "$expected" >>"$LOG"
        "$HOME/.local/bin/labwc-session-start" >>"$LOG" 2>&1 &
    fi
) >/dev/null 2>&1 &

# Labwc e Cage condividono la stessa sessione logind: quando una app chiede
# Cage, labwc esce, il wrapper avvia Cage sulla stessa TTY e poi riavvia labwc.
CAGE_REQUEST="$STATE/cage-request"
touch "$STATE/cage-supported" 2>/dev/null || true
while :; do
    labwc -C "$XDG_CONFIG_HOME/labwc"
    status=$?
    if [ -s "$CAGE_REQUEST" ]; then
        cage_cmd="$(cat "$CAGE_REQUEST")"
        rm -f "$CAGE_REQUEST"
        # Il controllo aggiornamenti e' un servizio della sessione labwc:
        # durante Cage non serve e non deve accumularsi a ogni riavvio.
        for pid in $(pgrep -f 'labwc-update-check --startup' 2>/dev/null); do
            pkill -P "$pid" 2>/dev/null || true
            kill "$pid" 2>/dev/null || true
        done
        printf 'cage: chiusura labwc, avvio %s\n' "$cage_cmd" >>"$LOG"
        (
            unset WAYLAND_DISPLAY DISPLAY XAUTHORITY
            # drm,libinput: solo "drm" disattiva il backend input di wlroots,
            # quindi Cage non vede mouse e tastiera.
            # Niente WLR_RENDERER=pixman: su Intel i915 le superfici DMABUF
            # di FreeTube/Electron restano nere. Lasciare il renderer
            # automatico (GLES2), che compone anche le superfici DMABUF.
            # WLR_DRM_NO_ATOMIC evita i freeze "Atomic commit failed:
            # Device or resource busy" quando una pagina web complessa tiene
            # la GPU occupata; WLR_DRM_NO_MODIFIERS evita i modifier DMABUF.
            export LABWC_CAGE_CLOSE="$STATE/cage-exit.request"
            rm -f "$STATE/cage.pid" "$STATE/cage-exit.request" 2>/dev/null || true
            LABWC_CAGE_QUIET=1 WLR_BACKENDS=drm,libinput \
                WLR_DRM_NO_ATOMIC=1 WLR_DRM_NO_MODIFIERS=1 \
                WLR_NO_HARDWARE_CURSORS=1 \
                cage -- bash -lc "$cage_cmd" &
            cage_pid=$!
            printf '%s\n' "$cage_pid" >"$STATE/cage.pid" 2>/dev/null || true
            while cage_pid_alive "$cage_pid"; do
                [ -f "$STATE/cage-exit.request" ] && break
                sleep 0.15
            done
            if [ -f "$STATE/cage-exit.request" ]; then
                printf 'cage: exit dalla console, chiusura di Cage e delle app\n' \
                    >>"$LOG"
            fi
            rm -f "$STATE/cage-exit.request" 2>/dev/null || true
            cage_kill_tree "$cage_pid"
            wait "$cage_pid" 2>/dev/null || true
            rm -f "$STATE/cage.pid" 2>/dev/null || true
        ) >>"$LOG" 2>&1
        printf 'cage: app terminata, riavvio labwc\n' >>"$LOG"
        continue
    fi
    exit "$status"
done
