#!/usr/bin/env python3
"""
labwc-cage-hud - HUD batteria per le app in Cage, acceso da Ctrl+Alt+B.

In Cage un solo client occupa lo schermo e non esiste layer-shell: il riquadro
viene quindi disegnato *dentro* l'app. Chromium/Electron espongono il DevTools
su localhost (--port, oppure --port-file per FreeTube); Firefox espone WebDriver
BiDi su localhost (--bidi). labwc-cage-app avvia questo processo e passa la
modalita' giusta.

Il riquadro e' visibile all'avvio, in basso a sinistra, con percentuale, stato
di carica e la combinazione per nasconderlo. Un clic sul riquadro lo ritrae
verso sinistra con un'animazione e lascia a vista una linguetta sottile; un
clic sulla linguetta lo riapre. Ctrl+Alt+B (B = batteria) fa lo stesso; il
vecchio Ctrl+. resta alias. Ctrl+B non si usa: apre i segnalibri in Firefox.

Uso:
  labwc-cage-hud --port 9222 [--pid PID]
  labwc-cage-hud --port-file /path/DevToolsActivePort
"""

from __future__ import annotations

import argparse
import asyncio
import contextlib
import json
import os
import signal
import sys
import time
import urllib.request

HUD_JS = r"""
(function () {
  // Se l'addon labwc-q4os battery monta gia' il suo HUD, non duplicarlo.
  if (document.documentElement &&
      document.documentElement.hasAttribute("data-lbqc-ext")) { return "extension"; }
  if (window.__lbqcHudInstalled) { return "already"; }
  window.__lbqcHudInstalled = true;

  function build() {
    // Con addPreloadScript il codice gira anche prima che esista <html>.
    if (!document.documentElement) { return null; }
    var host = document.getElementById("lbqc-hud-host");
    if (!host) {
      host = document.createElement("div");
      host.id = "lbqc-hud-host";
      host.setAttribute("data-lbqc", "hud");
      // Top layer: sopra video fullscreen e UI della pagina.
      host.setAttribute("popover", "manual");
      host.style.cssText = "position:fixed;inset:auto;left:0;bottom:0;width:0;height:0;" +
        "margin:0;padding:0;border:0;background:transparent;overflow:visible;";
      document.documentElement.appendChild(host);
      try { host.showPopover(); } catch (e) { /* browser senza popover */ }
      try {
        document.addEventListener("fullscreenchange", function () {
          try { host.hidePopover(); host.showPopover(); } catch (e) { /* noop */ }
        });
      } catch (e) { /* noop */ }
    }
    var root = host.shadowRoot;
    if (!root) { root = host.attachShadow({ mode: "open" }); }
    if (!root.getElementById("lbqc-hud")) {
      var style = document.createElement("style");
      style.textContent = `
        :host { all: initial; }
        #lbqc-hud {
          position: fixed; left: 0; bottom: 18px; z-index: 2147483646;
          display: flex; align-items: center; gap: 10px;
          padding: 9px 16px 9px 18px; border-radius: 0 999px 999px 0;
          background: rgba(15, 23, 42, 0.82);
          border: 1px solid rgba(148, 163, 184, 0.45); border-left: 0;
          color: #e2e8f0; font: 600 15px/1.1 system-ui, sans-serif;
          box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
          pointer-events: auto; cursor: pointer; user-select: none;
          transform: translateX(0); opacity: 1;
          transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease;
        }
        #lbqc-hud.lbqc-hidden {
          transform: translateX(-102%); opacity: 0; pointer-events: none;
        }
        #lbqc-tab {
          position: fixed; left: 0; bottom: 18px; z-index: 2147483647;
          width: 22px; height: 44px; box-sizing: border-box;
          display: flex; align-items: center; justify-content: center;
          border-radius: 0 10px 10px 0; background: rgba(15, 23, 42, 0.9);
          border: 1px solid rgba(148, 163, 184, 0.45); border-left: 0;
          color: #e2e8f0; cursor: pointer; user-select: none;
          pointer-events: auto; opacity: 0; transform: translateX(-10px);
          transition: opacity 0.25s ease, transform 0.25s ease;
        }
        #lbqc-tab.lbqc-visible { opacity: 1; transform: translateX(0); }
        #lbqc-batt {
          position: relative; width: 34px; height: 16px; border-radius: 4px;
          border: 2px solid currentColor; box-sizing: border-box;
        }
        #lbqc-batt::after {
          content: ""; position: absolute; right: -5px; top: 4px;
          width: 3px; height: 6px; border-radius: 0 2px 2px 0;
          background: currentColor;
        }
        #lbqc-fill {
          position: absolute; left: 1px; top: 1px; bottom: 1px;
          width: 60%; border-radius: 1px; background: #4ade80;
          transition: width 0.4s ease, background-color 0.4s ease;
        }
        #lbqc-fill.lbqc-low { background: #f87171; }
        #lbqc-fill.lbqc-mid { background: #fbbf24; }
        #lbqc-state { color: #94a3b8; font-size: 12px; font-weight: 500; }
        #lbqc-hint {
          color: #94a3b8; font-size: 11px; font-weight: 500;
          border-left: 1px solid rgba(148, 163, 184, 0.35);
          padding-left: 9px;
        }
      `;
      var box = document.createElement("div");
      box.id = "lbqc-hud";
      box.setAttribute("role", "status");
      box.title = "Clicca per nascondere";
      box.innerHTML = '<div id="lbqc-batt"><div id="lbqc-fill"></div></div>' +
        '<span id="lbqc-pct">--%</span><span id="lbqc-state"></span>' +
        '<span id="lbqc-hint">clicca o Ctrl+Alt+B per nascondere</span>';
      var tab = document.createElement("div");
      tab.id = "lbqc-tab";
      tab.title = "Mostra batteria";
      tab.innerHTML = '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">' +
        '<rect x="2" y="7" width="16" height="10" rx="2"></rect>' +
        '<rect x="19" y="10" width="2" height="4" rx="1" fill="currentColor" stroke="none"></rect>' +
        '<rect id="lbqc-tab-fill" x="4.5" y="9" width="8" height="6" rx="1" fill="currentColor" stroke="none"></rect>' +
        '</svg>';
      root.appendChild(style);
      root.appendChild(box);
      root.appendChild(tab);
      box.addEventListener("click", function () { window.__lbqcHudToggle(true); });
      tab.addEventListener("click", function () { window.__lbqcHudToggle(false); });
    }
    return host;
  }

  window.__lbqcHudToggle = function (hidden) {
    var host = build();
    if (!host) { return; }
    var root = host.shadowRoot;
    var box = root.getElementById("lbqc-hud");
    var tab = root.getElementById("lbqc-tab");
    if (!box || !tab) { return; }
    var hide = (typeof hidden === "boolean") ? hidden : !box.classList.contains("lbqc-hidden");
    box.classList.toggle("lbqc-hidden", hide);
    tab.classList.toggle("lbqc-visible", hide);
    if (!hide && window.__lbqcHudRefresh) {
      window.__lbqcHudRefresh();
    }
  };

  window.__lbqcHudSet = function (data) {
    var host = build();
    if (!host) { return "pending"; }
    var root = host.shadowRoot;
    var pct = Number(data && data.pct);
    var txt = root.getElementById("lbqc-pct");
    var fill = root.getElementById("lbqc-fill");
    var state = root.getElementById("lbqc-state");
    var tabFill = root.getElementById("lbqc-tab-fill");
    function setTabFill(value) {
      if (tabFill) { tabFill.setAttribute("width", String(value)); }
    }
    if (!isFinite(pct) || pct < 0) {
      txt.textContent = "AC";
      fill.style.width = "100%";
      fill.className = "";
      state.textContent = data && data.source ? String(data.source) : "";
      setTabFill(12);
      return "ac";
    }
    pct = Math.max(0, Math.min(100, Math.round(pct)));
    txt.textContent = pct + "%";
    fill.style.width = Math.max(4, pct) + "%";
    fill.className = pct <= 15 ? "lbqc-low" : (pct <= 35 ? "lbqc-mid" : "");
    setTabFill(Math.max(1.5, 10 * pct / 100));
    var charging = data && data.charging;
    state.textContent = charging ? "in carica" : "";
    return pct;
  };

  window.addEventListener("keydown", function (event) {
    // Comandi accettati: Ctrl+Alt+B (B = batteria) e, per Firefox dove i menu
    // rubano Alt+lettera, Ctrl+Shift+. come ripiego; Ctrl+. resta alias.
    window.__lbqcHudLastKey = [event.key, event.code, event.ctrlKey, event.altKey, event.shiftKey].join("|");
    if (event.metaKey) { return; }
    var key = (event.key || "").toLowerCase();
    var altB = event.ctrlKey && event.altKey && !event.shiftKey &&
      (key === "b" || event.code === "KeyB");
    var shiftDot = event.ctrlKey && !event.altKey && event.shiftKey &&
      (key === ">" || key === "." || event.code === "Period" || event.code === "NumpadDecimal");
    var plainDot = event.ctrlKey && !event.altKey && !event.shiftKey &&
      (key === "." || event.code === "Period" || event.code === "NumpadDecimal");
    if (!altB && !shiftDot && !plainDot) { return; }
    event.preventDefault();
    event.stopPropagation();
    window.__lbqcHudToggle();
  }, true);

  return "installed";
})();
"""


def log(message: str) -> None:
    print(f"labwc-cage-hud: {message}", file=sys.stderr, flush=True)


def http_json(port: int, path: str, timeout: float = 2.0):
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open(f"http://127.0.0.1:{port}{path}", timeout=timeout) as response:
        return json.load(response)


def page_targets(port: int) -> list[str]:
    try:
        targets = http_json(port, "/json/list")
    except Exception:
        return []
    pages = []
    for target in targets:
        if target.get("type") != "page":
            continue
        ws_url = target.get("webSocketDebuggerUrl") or ""
        if not ws_url or ws_url.startswith("devtools://"):
            continue
        pages.append(ws_url)
    return pages


def battery_state() -> dict[str, object]:
    root = "/sys/class/power_supply"
    try:
        entries = sorted(os.listdir(root))
    except OSError:
        entries = []
    for name in entries:
        if not name.startswith("BAT"):
            continue
        base = os.path.join(root, name)
        try:
            with open(os.path.join(base, "capacity"), encoding="utf-8") as handle:
                pct = int(handle.read().strip())
        except (OSError, ValueError):
            continue
        status = ""
        with contextlib.suppress(OSError):
            with open(os.path.join(base, "status"), encoding="utf-8") as handle:
                status = handle.read().strip()
        return {"pct": pct, "charging": status in ("Charging", "Full")}
    # Nessuna batteria (desktop/VM): alimentazione esterna.
    return {"pct": -1, "charging": True, "source": "rete"}


class Hud:
    def __init__(
        self,
        port: int | None,
        port_file: str | None,
        watch_pid: int | None,
        bidi_port: int | None = None,
    ):
        self.port = port
        self.port_file = port_file
        self.bidi_port = bidi_port
        self.watch_pid = watch_pid
        self.stop = asyncio.Event()

    def parent_alive(self) -> bool:
        if self.watch_pid is not None:
            pid = self.watch_pid
        else:
            pid = os.getppid()
        if pid <= 1:
            return False
        try:
            os.kill(pid, 0)
        except OSError:
            return False
        return True

    def resolve_port(self) -> int | None:
        if self.port is not None:
            return self.port
        if not self.port_file:
            return None
        try:
            with open(self.port_file, encoding="utf-8") as handle:
                lines = handle.read().splitlines()
        except OSError:
            return None
        if not lines:
            return None
        try:
            port = int(lines[0].strip())
        except ValueError:
            return None
        return port if 1 <= port <= 65535 else None


async def worker(hud: Hud, ws_url: str) -> None:
    import websockets

    try:
        async with websockets.connect(
            ws_url, max_size=None, ping_interval=None,
            open_timeout=5, close_timeout=1,
        ) as ws:
            counter = 0

            async def call(method: str, params: dict | None = None):
                nonlocal counter
                counter += 1
                payload = {"id": counter, "method": method, "params": params or {}}
                await ws.send(json.dumps(payload))
                while True:
                    reply = json.loads(await asyncio.wait_for(ws.recv(), timeout=10))
                    if reply.get("id") == counter:
                        return reply

            await call("Runtime.enable")
            await call("Page.enable")
            with contextlib.suppress(Exception):
                await call(
                    "Page.addScriptToEvaluateOnNewDocument", {"source": HUD_JS}
                )
            installed = False
            while not hud.stop.is_set() and hud.parent_alive():
                if not installed:
                    reply = await call("Runtime.evaluate", {
                        "expression": HUD_JS, "returnByValue": True,
                    })
                    value = (reply.get("result") or {}).get("result", {}).get("value")
                    installed = value in ("installed", "already") or bool(value)
                data = battery_state()
                expression = (
                    "window.__lbqcHudSet && window.__lbqcHudSet("
                    + json.dumps(data)
                    + ")"
                )
                try:
                    present = await call("Runtime.evaluate", {
                        "expression": "typeof window.__lbqcHudSet === 'function'",
                        "returnByValue": True,
                    })
                    value = (present.get("result") or {}).get("result", {}).get("value")
                    if value is not True:
                        installed = False
                except Exception:
                    installed = False
                try:
                    await call("Runtime.evaluate", {
                        "expression": expression, "returnByValue": True,
                    })
                except Exception:
                    installed = False
                # Attesa interrompibile: SIGTERM non deve aspettare.
                with contextlib.suppress(asyncio.TimeoutError):
                    await asyncio.wait_for(hud.stop.wait(), timeout=4)
    except Exception as error:
        log(f"connessione persa: {error}")
        raise


async def _bidi_hud_loop(hud: Hud, call) -> None:
    last_key = ""
    while not hud.stop.is_set() and hud.parent_alive():
        try:
            tree = await call("browsingContext.getTree", {})
        except Exception as error:
            log(f"BiDi: getTree fallito: {error}")
            raise
        contexts = [
            item["context"]
            for item in (tree.get("contexts") or [])
            if item.get("context")
        ]
        data = battery_state()
        payload = json.dumps(data)
        for context in contexts:
            target = {"context": context}
            try:
                present = await call("script.evaluate", {
                    "expression": "typeof window.__lbqcHudSet === 'function'",
                    "target": target,
                    "awaitPromise": False,
                    "resultOwnership": "none",
                })
                value = ((present.get("result") or {}).get("value"))
                if value is not True:
                    await call("script.evaluate", {
                        "expression": HUD_JS,
                        "target": target,
                        "awaitPromise": False,
                        "resultOwnership": "none",
                    })
                    if os.environ.get("LABWC_CAGE_HUD_DEBUG") == "1":
                        log(f"BiDi: HUD iniettato nel contesto {context}")
                await call("script.evaluate", {
                    "expression":
                        f"window.__lbqcHudSet && window.__lbqcHudSet({payload})",
                    "target": target,
                    "awaitPromise": False,
                    "resultOwnership": "none",
                })
                if os.environ.get("LABWC_CAGE_HUD_DEBUG") == "1":
                    probe = await call("script.evaluate", {
                        "expression": "window.__lbqcHudLastKey || ''",
                        "target": target,
                        "awaitPromise": False,
                        "resultOwnership": "none",
                    })
                    seen = ((probe.get("result") or {}).get("value"))
                    if seen and seen != last_key:
                        log(f"BiDi: ultimo tasto {seen}")
                        last_key = seen
            except Exception as error:
                if os.environ.get("LABWC_CAGE_HUD_DEBUG") == "1":
                    log(f"BiDi: contesto {context}: {error}")
        with contextlib.suppress(asyncio.TimeoutError):
            await asyncio.wait_for(hud.stop.wait(), timeout=3)


async def bidi_worker(hud: Hud, port: int) -> None:
    """HUD batteria in Firefox via WebDriver BiDi (--remote-debugging-port)."""
    import websockets

    async with websockets.connect(
        f"ws://127.0.0.1:{port}/session",
        max_size=None, ping_interval=None, open_timeout=10, close_timeout=1,
    ) as ws:
        counter = 0

        async def call(method: str, params: dict | None = None):
            nonlocal counter
            counter += 1
            await ws.send(json.dumps({
                "id": counter, "method": method, "params": params or {},
            }))
            while True:
                message = json.loads(await asyncio.wait_for(ws.recv(), timeout=15))
                if message.get("id") == counter:
                    if message.get("type") != "success":
                        raise RuntimeError(message.get("message") or "BiDi error")
                    return message.get("result") or {}

        await call("session.new", {"capabilities": {}})
        # Preload: reinstalla il HUD in ogni nuovo documento (YouTube, SPA,
        # navigazioni complete), cosi' non sparisce cambiando pagina.
        try:
            await call("script.addPreloadScript", {
                "functionDeclaration": "function () {\n" + HUD_JS + "\n}",
            })
        except Exception as error:
            if os.environ.get("LABWC_CAGE_HUD_DEBUG") == "1":
                log(f"BiDi: preload non disponibile: {error}")
        if os.environ.get("LABWC_CAGE_HUD_DEBUG") == "1":
            log("BiDi: sessione Firefox aperta")
        try:
            await _bidi_hud_loop(hud, call)
        finally:
            # Firefox tiene la sessione BiDi occupata: chiuderla esplicitamente,
            # altrimenti un riavvio del HUD non puo' aprirne una nuova.
            with contextlib.suppress(Exception):
                await asyncio.wait_for(call("session.end", {}), timeout=5)


async def bidi_loop(hud: Hud) -> int:
    while not hud.stop.is_set() and hud.parent_alive():
        try:
            await bidi_worker(hud, hud.bidi_port)
        except Exception as error:
            if os.environ.get("LABWC_CAGE_HUD_DEBUG") == "1":
                log(f"BiDi: riconnessione ({error})")
        with contextlib.suppress(asyncio.TimeoutError):
            await asyncio.wait_for(hud.stop.wait(), timeout=1.0)
    return 0


async def main_loop(hud: Hud) -> int:
    if hud.bidi_port is not None:
        return await bidi_loop(hud)
    empty_since = None
    had_page = False
    while not hud.stop.is_set():
        if not hud.parent_alive():
            return 0
        port = hud.resolve_port()
        pages = page_targets(port) if port else []
        if not pages:
            if had_page:
                if empty_since is None:
                    empty_since = time.monotonic()
                elif time.monotonic() - empty_since > 20:
                    return 0
            with contextlib.suppress(asyncio.TimeoutError):
                await asyncio.wait_for(hud.stop.wait(), timeout=0.6)
            continue
        empty_since = None
        had_page = True
        for ws_url in pages:
            if hud.stop.is_set():
                break
            try:
                await worker(hud, ws_url)
            except Exception:
                with contextlib.suppress(asyncio.TimeoutError):
                    await asyncio.wait_for(hud.stop.wait(), timeout=1.0)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="HUD batteria per Cage (Ctrl+Alt+B)")
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--port", type=int, help="porta DevTools su 127.0.0.1")
    group.add_argument("--port-file", help="file DevToolsActivePort dell'app")
    group.add_argument("--bidi", type=int, metavar="PORTA",
                       help="porta WebDriver BiDi di Firefox (--remote-debugging-port)")
    parser.add_argument("--pid", type=int, default=None, help="pid dell'app da seguire")
    args = parser.parse_args()

    try:
        import websockets  # noqa: F401
    except ImportError:
        log("python3-websockets non installato")
        return 1

    hud = Hud(args.port, args.port_file, args.pid, args.bidi)

    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        with contextlib.suppress(NotImplementedError):
            loop.add_signal_handler(signum, hud.stop.set)
    try:
        return loop.run_until_complete(main_loop(hud))
    finally:
        loop.close()


if __name__ == "__main__":
    raise SystemExit(main())
