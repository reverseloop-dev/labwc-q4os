#!/usr/bin/env bash
# =============================================================================
#  labwc-cage - chiude labwc, avvia l'app in Cage e poi riapre labwc.
#
#  La richiesta viene scritta in ~/.local/state/labwc-q4os/cage-request:
#  il wrapper di sessione labwc-session-launch la esegue sulla stessa TTY,
#  quindi labwc libera DRM e RAM e Cage parte davvero come compositore.
# =============================================================================
set -u

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        # Durante Cage non c'e' un demone notifiche: non bloccare lo script.
        timeout 2 notify-send -a "Cage" "$1" "${2:-}" >/dev/null 2>&1 || true
    else
        printf 'Cage: %s %s\n' "$1" "${2:-}" >&2
    fi
}

ask=0
if [ "${1:-}" = "--ask" ]; then
    ask=1
    shift
fi
if [ "${1:-}" = "--" ]; then
    shift
fi
[ "$#" -gt 0 ] || { notify "Nessun comando da avviare"; exit 1; }

# Un solo Cage alla volta: evita compositori annidati se il comando viene
# lanciato per errore dalla console dentro Cage o da un doppio click.
if pgrep -x cage >/dev/null 2>&1; then
    notify "Cage è già attivo" "Chiudi l'app corrente; per tornare usa labwc-return."
    exit 1
fi

if [ "$ask" -eq 1 ] && command -v zenity >/dev/null 2>&1; then
    zenity --question \
        --title="Cage — chiudere labwc?" \
        --text="Cage chiude labwc e avvia l'app a schermo intero.\n\nTutti i file non salvati andranno persi.\n\nContinuare?" \
        --ok-label="Sì" --cancel-label="No" 2>/dev/null || exit 0
fi

state="${XDG_STATE_HOME:-$HOME/.local/state}/labwc-q4os"
mkdir -p "$state"
request="$state/cage-request"

if [ ! -f "$state/cage-supported" ]; then
    # Sessione avviata prima dell'aggiornamento: il wrapper in memoria non
    # supporta ancora la richiesta Cage. Uso il compositore annidato finché
    # non viene riaperta la sessione.
    notify "Riavvia la sessione per Cage reale" "Per ora apro Cage annidato."
    log="$(mktemp)"
    LABWC_CAGE_QUIET=1 WLR_BACKENDS=wayland WLR_RENDERER=pixman \
        WLR_NO_HARDWARE_CURSORS=1 cage -- "$@" >"$log" 2>&1 &
    cage_pid=$!
    for _ in $(seq 1 40); do
        if wlrctl toplevel find app_id:wlroots >/dev/null 2>&1; then
            wlrctl toplevel fullscreen app_id:wlroots >/dev/null 2>&1 || true
            break
        fi
        sleep 0.2
    done
    wait "$cage_pid"
    status=$?
    rm -f "$log"
    exit "$status"
fi

printf '%q ' "$@" >"$request"
printf '\n' >>"$request"
sync

if ! pgrep -x labwc >/dev/null 2>&1; then
    # Siamo già in una console senza labwc: Cage può partire direttamente.
    exec cage -- "$@"
fi

# Il wrapper di sessione è il padre di labwc: sopravvive alla chiusura,
# avvia Cage e poi riapre labwc automaticamente.
pkill -TERM -x labwc 2>/dev/null || true
exit 0
