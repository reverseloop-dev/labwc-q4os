#!/usr/bin/env bash
# =============================================================================
#  labwc-update-apply - applica l'aggiornamento di labwc-q4os dalla GUI
#
#  Installato root-owned in /usr/local/libexec/labwc-q4os/update-apply e
#  avviato con pkexec dal pannello aggiornamenti: la password di root viene
#  chiesta una sola volta, nell'agent polkit (finestra grafica).
#
#  L'installer gira come root per evitare prompt sudo multipli; i file
#  dell'utente vengono riportati al proprietario originale a fine corsa.
#  I sorgenti sono clonati in una directory temporanea root-owned, cosi' un
#  utente non puo' iniettare codice nello script eseguito come root.
#
#  Uso (solo root): labwc-update-apply UTENTE
# =============================================================================
set -euo pipefail

[ "$(id -u)" -eq 0 ] || { printf 'labwc-update-apply richiede root.\n' >&2; exit 1; }

REPO_URL="https://github.com/reverseloop-dev/labwc-q4os.git"
target_user="${1:-}"
[ -n "$target_user" ] || { printf 'Uso: labwc-update-apply UTENTE\n' >&2; exit 2; }

entry="$(getent passwd "$target_user" 2>/dev/null)" || {
    printf 'Utente sconosciuto: %s\n' "$target_user" >&2
    exit 2
}
target_home="$(printf '%s' "$entry" | cut -d: -f6)"
target_group="$(id -gn "$target_user")"
target_uid="$(id -u "$target_user")"
[ "$target_uid" -ge 1000 ] || {
    printf 'Utente non valido (UID %s): %s\n' "$target_uid" "$target_user" >&2
    exit 2
}
[ -d "$target_home" ] || { printf 'Home inesistente: %s\n' "$target_home" >&2; exit 2; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

printf '[labwc-q4os] Scarico i sorgenti aggiornati...\n'
if ! git clone --depth 1 "$REPO_URL" "$work/src" >/dev/null 2>&1; then
    printf '[labwc-q4os] Download dei sorgenti non riuscito.\n' >&2
    exit 1
fi

printf '[labwc-q4os] Avvio installer (aggiornamento automatico, opzioni salvate)...\n'
opts=(--yes)
options_file="/etc/labwc-q4os/install-options"
opt_value() {
    [ -r "$options_file" ] || return 1
    local value
    value="$(sed -n "s/^$1=//p" "$options_file" | head -n1)"
    [ -n "$value" ] && printf '%s' "$value"
}
case "$(opt_value SHELL)" in
    waybar|noctalia) opts+=(--shell "$(opt_value SHELL)") ;;
esac
case "$(opt_value TOUCH)" in
    0) opts+=(--no-touch) ;;
    1) opts+=(--touch) ;;
esac
case "$(opt_value LOOKSWITCHER)" in
    0) opts+=(--no-lookswitcher) ;;
    1) opts+=(--lookswitcher) ;;
esac
case "$(opt_value ZRAM)" in
    0) opts+=(--no-zram) ;;
    1) opts+=(--zram) ;;
esac
case "$(opt_value SWAPPINESS_ENABLED)" in
    0) opts+=(--no-swappiness) ;;
    1)
        swappiness="$(opt_value SWAPPINESS_VALUE || true)"
        if [ -n "$swappiness" ]; then
            opts+=(--swappiness "$swappiness")
        fi
        ;;
esac
theme_saved="$(opt_value THEME || true)"
case "$theme_saved" in
    nordic-cobalt|muted-crimson|sage-emerald) opts+=(--theme "$theme_saved") ;;
esac
[ "$(opt_value KEEP_TDM)" = "1" ] && opts+=(--keep-tdm)

status=0
env HOME="$target_home" USER="$target_user" LOGNAME="$target_user" \
    LABWC_Q4OS_ALLOW_ROOT=1 \
    XDG_CONFIG_HOME="$target_home/.config" \
    XDG_DATA_HOME="$target_home/.local/share" \
    XDG_STATE_HOME="$target_home/.local/state" \
    bash "$work/src/install.sh" "${opts[@]}" || status=$?

# Ripristina il proprietario dei file creati come root.
for path in \
    "$target_home/.config/labwc" \
    "$target_home/.config/waybar" \
    "$target_home/.config/fuzzel" \
    "$target_home/.config/mako" \
    "$target_home/.config/wlogout" \
    "$target_home/.config/gtk-3.0" \
    "$target_home/.config/gtk-4.0" \
    "$target_home/.config/noctalia" \
    "$target_home/.local/share/applications" \
    "$target_home/.local/bin" \
    "$target_home/.local/share/labwc-q4os" \
    "$target_home/.local/share/icons" \
    "$target_home/.local/share/icons/labwc-q4os" \
    "$target_home/.local/state/labwc-q4os"
do
    [ -e "$path" ] && chown -Rh "$target_user:$target_group" "$path"
done

if [ "$status" -eq 0 ]; then
    printf '[labwc-q4os] Aggiornamento completato.\n'
else
    printf '[labwc-q4os] Aggiornamento non riuscito (codice %s).\n' "$status" >&2
fi
exit "$status"
