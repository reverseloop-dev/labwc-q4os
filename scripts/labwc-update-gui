#!/usr/bin/env python3
"""
labwc-update-gui - pannello aggiornamenti di labwc-q4os.

Separato dal pannello ZRAM. Permette di:
  * abilitare/disabilitare il controllo all'avvio;
  * controllare subito la versione online;
  * copiare il comando di aggiornamento negli appunti;
  * aprire il repository.
"""

from __future__ import annotations

import fcntl
import getpass
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
from pathlib import Path


HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
SHARE = Path(
    os.environ.get(
        "LABWC_Q4OS_SHARE",
        Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "labwc-q4os",
    )
)
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "labwc-q4os"
UPDATE_CHECK = HOME / ".local/bin/labwc-update-check"
UPDATE_COPY = HOME / ".local/bin/labwc-update-copy"
UPDATE_RUN = HOME / ".local/bin/labwc-update-run"
SYSTEM_FLAG = Path("/etc/labwc-q4os/update-check.enabled")
USER_DISABLED = CONFIG / "labwc/update-check.disabled"
LEGACY_FLAG = CONFIG / "labwc/update-check.enabled"
INTERVAL_FILE = CONFIG / "labwc/update-check.interval"
ROOT_HELPER = Path("/usr/local/libexec/labwc-q4os/update-toggle")
POPUP_SECONDS = 15
STATUS = STATE / "update-status.json"
REPO = "https://github.com/reverseloop-dev/labwc-q4os"
COMMAND = (
    "curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 "
    "https://raw.githubusercontent.com/reverseloop-dev/labwc-q4os/main/bootstrap.sh | bash"
)

GUI_LOCK = STATE / "update-gui.lock"
GUI_PID = STATE / "update-gui.pid"
_gui_lock_handle = None


def acquire_single_instance() -> bool:
    """Un solo pannello alla volta: la seconda apertura riporta in primo piano
    quello esistente invece di creare finestre sovrapposte (loop di popup)."""
    global _gui_lock_handle
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        handle = open(GUI_LOCK, "w")
    except OSError:
        return True
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        try:
            pid = int(GUI_PID.read_text(encoding="utf-8").strip())
            os.kill(pid, signal.SIGUSR1)
        except (OSError, ValueError):
            pass
        handle.close()
        return False
    _gui_lock_handle = handle
    try:
        GUI_PID.write_text(f"{os.getpid()}\n", encoding="utf-8")
    except OSError:
        pass
    return True



def theme_colors() -> dict[str, str]:
    theme = "nordic-cobalt"
    try:
        theme = (CONFIG / "labwc/theme").read_text(encoding="utf-8").strip() or theme
    except OSError:
        pass
    colors = {
        "BG": "070d1a",
        "SURFACE": "1e293b",
        "SURFACE_ALT": "273449",
        "ACCENT": "3b82f6",
        "ACCENT_SOFT": "60a5fa",
        "FG": "e2e8f0",
        "FG_MUTED": "94a3b8",
        "BORDER": "334155",
        "DANGER": "f87171",
    }
    path = SHARE / "themes" / theme / "theme.conf"
    if path.is_file():
        try:
            for raw in path.read_text(encoding="utf-8").splitlines():
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                value = value.strip().strip('"').strip("'").lstrip("#")
                if key in colors and value:
                    colors[key] = value
        except OSError:
            pass
    return colors


def base_css(c: dict[str, str]) -> str:
    return f"""
        window {{ background-color: #{c['BG']}; color: #{c['FG']}; }}
        .title {{ font-size: 24px; font-weight: 700; }}
        .subtitle {{ color: #{c['FG_MUTED']}; font-size: 12px; }}
        .card {{ background-color: #{c['SURFACE']}; border: 1px solid #{c['BORDER']};
                 border-radius: 14px; padding: 14px; }}
        .status {{ color: #{c['ACCENT_SOFT']}; font-size: 12px; font-weight: 600; }}
        .command {{ background-color: #{c['SURFACE_ALT']}; color: #{c['FG']};
                    border-radius: 8px; padding: 8px; font-family: monospace; font-size: 11px; }}
        textview.console, textview.console text {{
                    background-color: #000000; color: #d7f5d0;
                    font-family: monospace; font-size: 12px; }}
        checkbutton {{ color: #{c['FG']}; }}
        button {{ background-image: none; background-color: #{c['SURFACE_ALT']};
                  color: #{c['FG']}; border: 1px solid #{c['BORDER']};
                  border-radius: 9px; padding: 7px 14px; font-weight: 600; }}
        button label {{ color: #{c['FG']}; }}
        button:hover {{ background-image: none; border-color: #{c['ACCENT']}; }}
        checkbutton {{ color: #{c['FG']}; }}
        checkbutton check {{ background-image: none; background-color: #{c['SURFACE_ALT']};
                             border: 1px solid #{c['BORDER']}; }}
        checkbutton check:checked {{ background-image: none; background-color: #{c['ACCENT']}; }}
        combobox, combobox button {{ background-image: none; color: #{c['FG']}; }}
        button.suggested {{ background-color: #{c['ACCENT']}; color: #{c['BG']}; }}
        progressbar trough {{ background-color: #{c['SURFACE_ALT']}; border-radius: 6px; }}
        progressbar progress {{ background-color: #{c['ACCENT']}; border-radius: 6px; }}
        """


class UpdateWindow:
    def __init__(self) -> None:
        import gi

        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gdk, GLib, Gtk

        self.GLib = GLib
        self.Gtk = Gtk
        colors = theme_colors()

        provider = Gtk.CssProvider()
        provider.load_from_data(base_css(colors).encode("utf-8"))
        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        self.toggle_busy = False
        self.upgrade_checking = False
        self.window = Gtk.Window(title="Aggiornamenti labwc-q4os")
        self.window.set_default_size(680, 560)
        self.window.set_border_width(16)
        self.window.set_position(Gtk.WindowPosition.CENTER)
        self.window.set_icon_name("software-update-available")
        self.window.connect("destroy", Gtk.main_quit)
        self.GLib.unix_signal_add(
            self.GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.present_window
        )

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.window.add(outer)

        title = Gtk.Label(label="Aggiornamenti labwc-q4os", xalign=0)
        title.get_style_context().add_class("title")
        subtitle = Gtk.Label(
            label="Controllo versione, comando di aggiornamento e repository",
            xalign=0,
        )
        subtitle.get_style_context().add_class("subtitle")
        outer.pack_start(title, False, False, 0)
        outer.pack_start(subtitle, False, False, 0)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card.get_style_context().add_class("card")
        outer.pack_start(card, False, False, 0)

        self.toggle = Gtk.CheckButton(label="Controlla aggiornamenti all'avvio")
        self.toggle.set_active(self.updates_enabled())
        self.toggle.connect("toggled", self.on_toggle)
        card.pack_start(self.toggle, False, False, 0)

        interval_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        interval_label = Gtk.Label(label="Intervallo controllo:", xalign=0)
        self.interval = Gtk.ComboBoxText()
        for seconds, label in ((3600, "1 ora"), (10800, "3 ore"), (21600, "6 ore"),
                               (43200, "12 ore"), (86400, "24 ore")):
            self.interval.append(str(seconds), label)
        self.interval.set_active_id(str(self.interval_value()))
        apply_interval = Gtk.Button(label="Applica intervallo")
        apply_interval.connect("clicked", self.on_interval)
        interval_row.pack_start(interval_label, False, False, 0)
        interval_row.pack_start(self.interval, False, False, 0)
        interval_row.pack_start(apply_interval, False, False, 0)
        card.pack_start(interval_row, False, False, 0)

        self.status_text = Gtk.Label(label=self.status_text_value(), xalign=0)
        self.status_text.get_style_context().add_class("status")
        card.pack_start(self.status_text, False, False, 0)

        self.command_label = Gtk.Label(label=COMMAND, xalign=0)
        self.command_label.set_selectable(True)
        self.command_label.set_line_wrap(True)
        self.command_label.get_style_context().add_class("command")
        card.pack_start(self.command_label, False, False, 0)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.upgrade_button = Gtk.Button(label="Aggiorna ora")
        self.upgrade_button.get_style_context().add_class("suggested")
        self.upgrade_button.connect("clicked", self.on_upgrade)
        self.check_button = Gtk.Button(label="Controlla ora")
        self.check_button.connect("clicked", self.on_check)
        copy_button = Gtk.Button(label="Copia comando")
        copy_button.connect("clicked", self.on_copy)
        repo_button = Gtk.Button(label="Apri repository")
        repo_button.connect("clicked", self.on_repo)
        close_button = Gtk.Button(label="Chiudi")
        close_button.connect("clicked", lambda _b: self.window.destroy())
        buttons.pack_start(self.upgrade_button, False, False, 0)
        buttons.pack_start(self.check_button, False, False, 0)
        buttons.pack_start(copy_button, False, False, 0)
        buttons.pack_start(repo_button, False, False, 0)
        buttons.pack_end(close_button, False, False, 0)
        outer.pack_start(buttons, False, False, 0)

        footer = Gtk.Label(
            label="Aggiorna ora controlla prima la versione: se è già installata "
                  "te lo dice; se è nuova puoi copiare il comando o aprirlo nel "
                  "terminale, dove l'installer rifà le domande.",
            xalign=0,
        )
        footer.set_line_wrap(True)
        footer.get_style_context().add_class("subtitle")
        outer.pack_end(footer, False, False, 0)

        self.window.show_all()

    def on_upgrade(self, _button) -> None:
        # Sempre preceduto dal controllo: prima verifica, poi propone come
        # installare (copia comando o terminale) solo se c'e' una nuova versione.
        if self.upgrade_checking:
            return
        self.upgrade_checking = True
        self.upgrade_button.set_sensitive(False)
        self.status_text.set_text("Controllo aggiornamenti prima di procedere…")

        def worker() -> None:
            try:
                subprocess.run(
                    [str(UPDATE_CHECK), "--force"],
                    capture_output=True,
                    text=True,
                    timeout=30,
                    check=False,
                )
            except (OSError, subprocess.SubprocessError):
                pass
            data = self.read_status()
            self.GLib.idle_add(self.after_update_check, data)

        threading.Thread(target=worker, daemon=True).start()

    def read_status(self) -> dict:
        try:
            return json.loads(STATUS.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return {}

    def after_update_check(self, data: dict) -> bool:
        self.upgrade_checking = False
        self.upgrade_button.set_sensitive(True)
        installed = str(data.get("installed") or "?")
        online = str(data.get("online") or "")
        if not online:
            self.status_text.set_text("Controllo non riuscito: rete non disponibile?")
            self.show_info(
                "Controllo non riuscito",
                "Non è stato possibile leggere la versione online.\n"
                "Controlla la connessione e riprova.",
            )
            return False
        if not data.get("available"):
            self.status_text.set_text(self.status_text_value())
            if online == installed:
                text = (
                    f"La versione {installed} è già installata ed è uguale a "
                    "quella di sistema.\nNon serve aggiornare."
                )
            else:
                text = (
                    f"Nessun aggiornamento disponibile.\n"
                    f"Installata: {installed}\nOnline: {online}"
                )
            self.show_info("Nessun aggiornamento", text)
            return False
        self.status_text.set_text(f"Nuova versione disponibile: {online}")
        self.show_install_choice(installed, online)
        return False

    def show_info(self, title: str, text: str) -> None:
        Gtk = self.Gtk
        dialog = Gtk.MessageDialog(
            transient_for=self.window,
            modal=True,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.CLOSE,
            text=title,
        )
        dialog.format_secondary_text(text)
        dialog.run()
        dialog.destroy()

    def show_install_choice(self, installed: str, online: str) -> None:
        Gtk = self.Gtk
        dialog = Gtk.Dialog(
            title="Nuova versione disponibile",
            transient_for=self.window,
            modal=True,
        )
        dialog.set_default_size(560, 240)
        dialog.set_border_width(16)
        box = dialog.get_content_area()
        heading = Gtk.Label(xalign=0)
        heading.set_markup(
            f"<b>Nuova versione {online}</b> disponibile (installata {installed})."
        )
        heading.set_line_wrap(True)
        detail = Gtk.Label(
            label="Scegli come aggiornare: il terminale esegue il comando e "
                  "l'installer rifà le domande; oppure copia il comando e "
                  "incollalo tu.",
            xalign=0,
        )
        detail.set_line_wrap(True)
        detail.get_style_context().add_class("subtitle")
        box.pack_start(heading, False, False, 0)
        box.pack_start(detail, False, False, 0)

        dialog.add_button("Annulla", Gtk.ResponseType.CANCEL)
        copy_button = dialog.add_button("Copia comando", Gtk.ResponseType.APPLY)
        term_button = dialog.add_button("Apri nel terminale", Gtk.ResponseType.OK)
        copy_button.get_style_context().add_class("suggested")
        term_button.get_style_context().add_class("suggested")
        dialog.show_all()
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            if UPDATE_RUN.is_file():
                subprocess.Popen([str(UPDATE_RUN)], start_new_session=True)
                self.status_text.set_text(
                    "Aggiornamento avviato nel terminale: rispondi alle domande."
                )
            else:
                self.status_text.set_text("labwc-update-run non trovato.")
        elif response == Gtk.ResponseType.APPLY:
            self.on_copy(None)


    def start_upgrade(self) -> bool:
        self.on_upgrade(None)
        return False

    def updates_enabled(self) -> bool:
        try:
            enabled = SYSTEM_FLAG.read_text(encoding="utf-8").strip() == "1"
        except OSError:
            enabled = False
        if not enabled or USER_DISABLED.exists():
            return False
        try:
            if LEGACY_FLAG.read_text(encoding="utf-8").strip() == "0":
                return False
        except OSError:
            pass
        return True

    def interval_value(self) -> int:
        try:
            value = int(INTERVAL_FILE.read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            return 21600
        return max(300, min(604800, value))

    def on_interval(self, _button) -> None:
        value = self.interval.get_active_id() or "21600"
        try:
            INTERVAL_FILE.parent.mkdir(parents=True, exist_ok=True)
            INTERVAL_FILE.write_text(value + "\n", encoding="utf-8")
            self.status_text.set_text(f"Intervallo aggiornato: {self.interval.get_active_text()}.")
        except OSError as exc:
            self.status_text.set_text(f"Errore: {exc}")

    def status_text_value(self) -> str:
        try:
            data = json.loads(STATUS.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return "Nessun controllo effettuato in questa sessione."
        if data.get("available"):
            return (
                f"Nuova versione disponibile: {data.get('online', '?')} "
                f"(installata {data.get('installed', '?')})"
            )
        if not data.get("online"):
            return "Ultimo controllo non riuscito (rete non disponibile?)."
        return f"Versione aggiornata: {data.get('installed', '?')}"

    def on_toggle(self, button) -> None:
        if self.toggle_busy:
            return
        if button.get_active():
            # L'attivazione richiede la password di root.
            if not ROOT_HELPER.is_file():
                self.status_text.set_text("Helper root mancante: esegui install.sh.")
                button.set_active(False)
                return
            if not shutil.which("pkexec"):
                self.status_text.set_text("pkexec non disponibile: serve la password di root.")
                button.set_active(False)
                return
            self.toggle.set_sensitive(False)
            self.status_text.set_text("Autenticazione root in corso…")

            def worker() -> None:
                result = subprocess.run(
                    ["pkexec", str(ROOT_HELPER), "enable", os.environ.get("USER", "")],
                    capture_output=True,
                    text=True,
                    timeout=120,
                    check=False,
                )
                self.GLib.idle_add(self.toggle_done, result.returncode == 0, result.stderr)

            threading.Thread(target=worker, daemon=True).start()
            return

        try:
            USER_DISABLED.parent.mkdir(parents=True, exist_ok=True)
            USER_DISABLED.write_text("1\n", encoding="utf-8")
            subprocess.run(
                ["pkill", "-f", "labwc-update-check --startup"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            self.status_text.set_text("Controllo aggiornamenti disattivato (nessuna password richiesta).")
        except OSError as exc:
            self.status_text.set_text(f"Errore: {exc}")
            self.toggle.set_active(True)

    def toggle_done(self, success: bool, error: str) -> bool:
        self.toggle_busy = True
        self.toggle.set_sensitive(True)
        if success:
            self.toggle.set_active(True)
            self.status_text.set_text("Controllo aggiornamenti attivato con autorizzazione root.")
            if UPDATE_CHECK.is_file():
                subprocess.Popen(
                    [str(UPDATE_CHECK), "--startup"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
        else:
            self.toggle.set_active(False)
            detail = (error or "").strip().splitlines()[-1] if error else "autenticazione annullata"
            self.status_text.set_text(f"Attivazione non riuscita: {detail}")
        self.toggle_busy = False
        return False

    def on_check(self, _button) -> None:
        if not UPDATE_CHECK.is_file():
            self.status_text.set_text("labwc-update-check non trovato.")
            return
        self.check_button.set_sensitive(False)
        self.status_text.set_text("Controllo in corso…")

        def worker() -> None:
            try:
                subprocess.run(
                    [str(UPDATE_CHECK), "--force"],
                    capture_output=True,
                    text=True,
                    timeout=30,
                    check=False,
                )
            except (OSError, subprocess.SubprocessError):
                pass
            self.GLib.idle_add(self.check_done)

        threading.Thread(target=worker, daemon=True).start()

    def check_done(self) -> bool:
        self.check_button.set_sensitive(True)
        self.status_text.set_text(self.status_text_value())
        return False

    def on_copy(self, _button) -> None:
        if UPDATE_COPY.is_file():
            subprocess.Popen([str(UPDATE_COPY)], start_new_session=True)
            self.status_text.set_text("Comando copiato negli appunti.")
        else:
            self.status_text.set_text("labwc-update-copy non trovato.")

    def on_repo(self, _button) -> None:
        subprocess.Popen(["xdg-open", REPO], start_new_session=True)

    def present_window(self) -> bool:
        self.window.present()
        return True

    def run(self) -> int:
        self.Gtk.main()
        return 0


class UpdatePopup:
    """Avviso di nuova versione: si chiude da solo dopo POPUP_SECONDS e offre
    Chiudi, copia del comando shell e apertura del pannello con la GUI."""

    def __init__(self, installed: str, online: str) -> None:
        import gi

        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gdk, GLib, Gtk

        self.GLib = GLib
        self.Gtk = Gtk
        self.Gdk = Gdk
        self.remaining = POPUP_SECONDS

        provider = Gtk.CssProvider()
        provider.load_from_data(base_css(theme_colors()).encode("utf-8"))
        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        self.window = Gtk.Window(title="Labwc Q4OS — aggiornamento disponibile")
        self.window.set_default_size(560, 320)
        self.window.set_resizable(False)
        self.window.set_border_width(16)
        self.window.set_position(Gtk.WindowPosition.CENTER)
        self.window.set_icon_name("software-update-available")
        self.window.connect("destroy", self.on_destroy)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.window.add(outer)

        title = Gtk.Label(label="Nuova versione di labwc-q4os", xalign=0)
        title.get_style_context().add_class("title")
        versions = Gtk.Label(label=f"Installata: {installed}   ·   Disponibile: {online}", xalign=0)
        versions.get_style_context().add_class("subtitle")
        versions.set_line_wrap(True)
        outer.pack_start(title, False, False, 0)
        outer.pack_start(versions, False, False, 0)

        self.countdown = Gtk.Label(xalign=0)
        self.countdown.get_style_context().add_class("status")
        outer.pack_start(self.countdown, False, False, 0)
        self.update_countdown()

        self.status = Gtk.Label(label="", xalign=0)
        self.status.get_style_context().add_class("subtitle")
        outer.pack_start(self.status, False, False, 0)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        close_button = Gtk.Button(label="Chiudi")
        close_button.connect("clicked", lambda _b: self.window.destroy())
        copy_button = Gtk.Button(label="Copia stringa shell")
        copy_button.connect("clicked", self.on_copy)
        open_button = Gtk.Button(label="Apri app per aggiornare")
        open_button.get_style_context().add_class("suggested")
        open_button.connect("clicked", self.on_open_app)
        buttons.pack_start(close_button, False, False, 0)
        buttons.pack_start(copy_button, False, False, 0)
        buttons.pack_end(open_button, False, False, 0)
        outer.pack_end(buttons, False, False, 0)

        self.window.show_all()
        self.timer = GLib.timeout_add_seconds(1, self.tick)

    def update_countdown(self) -> None:
        self.countdown.set_text(
            f"Questa finestra si chiude automaticamente tra {self.remaining} secondi."
        )

    def tick(self) -> bool:
        self.remaining -= 1
        if self.remaining <= 0:
            self.window.destroy()
            return False
        self.update_countdown()
        return True

    def on_destroy(self, *_args) -> None:
        if getattr(self, "timer", None):
            self.GLib.source_remove(self.timer)
            self.timer = None
        self.Gtk.main_quit()

    def on_copy(self, _button) -> None:
        try:
            subprocess.run(
                ["wl-copy"],
                input=COMMAND,
                text=True,
                timeout=5,
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except (OSError, subprocess.SubprocessError):
            clipboard = self.Gtk.Clipboard.get(self.Gdk.SELECTION_CLIPBOARD)
            clipboard.set_text(COMMAND, -1)
            clipboard.store()
        self.status.set_text("Comando copiato negli appunti.")

    def on_open_app(self, _button) -> None:
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve())],
            start_new_session=True,
        )
        self.window.destroy()


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if "-h" in args or "--help" in args:
        print("Uso: labwc-update-gui [--popup INSTALLATA ONLINE | --upgrade]")
        return 0

    try:
        import gi

        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gtk
    except (ImportError, ValueError) as exc:
        print(f"GTK3/PyGObject non disponibile: {exc}", file=sys.stderr)
        return 1
    Gtk.init([])

    if args and args[0] == "--popup":
        installed = args[1] if len(args) > 1 else "?"
        online = args[2] if len(args) > 2 else "?"
        UpdatePopup(installed, online)
        Gtk.main()
        return 0

    if "--smoke" in args:
        UpdateWindow()
        print("GUI_OK")
        return 0

    if not acquire_single_instance():
        return 0
    window = UpdateWindow()
    if "--upgrade" in args:
        window.GLib.idle_add(window.start_upgrade)
    return window.run()



if __name__ == "__main__":
    raise SystemExit(main())
