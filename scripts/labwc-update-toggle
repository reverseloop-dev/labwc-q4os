#!/usr/bin/env bash
# =============================================================================
#  labwc-update-toggle - helper root per abilitare il controllo aggiornamenti
#  Installato root-owned in /usr/local/libexec/labwc-q4os/
# =============================================================================
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    printf 'Questo helper richiede i privilegi di root.\n' >&2
    exit 1
fi

action="${1:-}"
user="${2:-}"

case "$action" in
    enable)
        install -d -m 0755 /etc/labwc-q4os
        printf '1\n' > /etc/labwc-q4os/update-check.enabled
        chmod 0644 /etc/labwc-q4os/update-check.enabled
        if [ -n "$user" ]; then
            home="$(getent passwd "$user" | cut -d: -f6)"
            if [ -n "$home" ] && [ -d "$home" ]; then
                rm -f "$home/.config/labwc/update-check.disabled"
            fi
        fi
        printf 'Controllo aggiornamenti abilitato.\n'
        ;;
    disable)
        install -d -m 0755 /etc/labwc-q4os
        printf '0\n' > /etc/labwc-q4os/update-check.enabled
        chmod 0644 /etc/labwc-q4os/update-check.enabled
        printf 'Controllo aggiornamenti disabilitato.\n'
        ;;
    *)
        printf 'Uso: %s {enable|disable} [utente]\n' "$(basename "$0")" >&2
        exit 2
        ;;
esac
