{
  "manifest_version": 2,
  "name": "labwc-q4os Battery HUD",
  "version": "1.0.0",
  "description": "Batteria, carica e durata stimata nelle pagine di Firefox in Cage.",
  "browser_specific_settings": {
    "gecko": {
      "id": "labwc-q4os-battery@reverseloop.dev",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["nativeMessaging"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
